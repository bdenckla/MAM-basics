digraph mam_pipeline {
    // This file was generated by MAM-basics/py/main_pipeline_graph.py.
    // Do not edit by hand; edit py/pipeline_graph/pipeline_graph_spec.py instead.
    graph [comment="This file was generated by MAM-basics/py/main_pipeline_graph.py."];
    // Generated from structured pipeline data.
    rankdir=LR;
    graph [fontname="Helvetica", fontsize=10, labelloc=b, labeljust=l, label="Solid box: a program that py/main_0_mega.py runs, labelled with its step ids.\nDashed gray box: a program run by hand."];
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];

    // ── Data stores ──
    node [shape=cylinder];
    src_ws_live     [label="Hebrew Wikisource"];
    ds_ws           [label="in/mam-ws/\n(Wikisource JSON)"];
    ds_ws_special   [label="in/mam-ws-special/\n(raw Wikitext)"];
    ds_parsed_plus  [label="MAM-parsed/plus/"];
    ds_simple       [label="MAM-simple/"];
    ds_sefaria      [label="MAM-for-Sefaria/"];
    ds_osis         [label="MAM-OSIS/"];
    ds_with_doc     [label="gh-pages/MAM-with-doc/"];

    // ── Programs run by hand (not steps of py/main_0_mega.py) ──
    node [shape=box, style=dashed, color=gray, fontcolor=gray];
    download_ws     [label="main_download.py fr-wikisource"];
    mam4sef         [label="main_mam4sef.py"];
    osis            [label="main_mam_osis.py"];
    ws_bot          [label="main_ws_bot.py real"];

    // ── Programs that steps of py/main_0_mega.py run ──
    node [shape=box, style="", color="", fontcolor=""];
    parse_ws        [label="main_parse.py ws\nmega step: parse-ws"];
    mam_simple      [label="main_mam_simple.py\nmega steps: mam-simple, mam-simple-docs"];
    mam_with_doc    [label="main_mam_with_doc.py\nmega step: mam-with-doc"];

    // ── Edges ──
    src_ws_live    -> download_ws;
    download_ws    -> ds_ws;
    download_ws    -> ds_ws_special;
    download_ws    -> ds_parsed_plus [tooltip="via automatic reparse"];
    ds_ws          -> parse_ws;
    parse_ws       -> ds_parsed_plus;
    ds_parsed_plus -> mam_simple;
    mam_simple     -> ds_simple;
    ds_simple      -> mam4sef;
    mam4sef        -> ds_sefaria;
    ds_simple      -> osis;
    osis           -> ds_osis;
    ds_parsed_plus -> mam_with_doc;
    mam_with_doc   -> ds_with_doc;
    ws_bot         -> src_ws_live;
    ws_bot         -> ds_ws;
    ws_bot         -> ds_ws_special;
    ws_bot         -> ds_parsed_plus [tooltip="via automatic post-download reparse"];
}
