digraph mam_pipeline {
    // Speculation: this file may have been produced with Claude Code assistance.
    rankdir=LR;
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];

    // ── Data stores ──
    node [shape=cylinder];
    ds_go_csv    [label="in/mam-go/\n(Google CSV)"];
    ds_parsed_plus  [label="../MAM-parsed/plus/"];
    ds_parsed_plain [label="../MAM-parsed/plain/"];
    ds_ws        [label="in/mam-ws/\n(Wikisource JSON)"];
    src_ws_live  [label="Hebrew Wikisource"];
    ds_simple    [label="../MAM-simple/out/"];
    ds_with_doc  [label="../MAM-with-doc/docs/"];
    ds_sefaria   [label="../MAM-for-Sefaria/out/"];
    ds_osis      [label="../MAM-OSIS/"];
    ds_out       [label="out/\n(local outputs)"];
    ds_mamgo_auto [label="../mamgo-auto-edits/"];

    // ── External prerequisites (not part of _STEPS) ──
    node [shape=box, style=dashed, color=gray, fontcolor=gray];
    download_go  [label="download_fr_google"];
    download_sef [label="download_fr_sefaria"];
    download_ws  [label="download_fr_wikisource", style="", color="", fontcolor=""];

    // ── Pipeline steps ──
    node [shape=box, style="", color="", fontcolor=""];
    parse_go     [label="parse_go"];
    foi          [label="foi_features_of_interest"];
    mam_with_doc [label="mam_with_doc"];
    tmpl_survey  [label="tmpl_survey"];
    mam_simple   [label="mam_simple"];
    misc_2       [label="misc-2", tooltip="mam4sef\nmam4ajf"];
    osis         [label="osis"];
    misc_1       [label="misc-1", tooltip="decnreub\nmultimark\nwordlist\nexplicit_xataf\ndiff_ctr_vs_mam"];
    diff_wsgo    [label="diff_wsgo"];
    misc_3       [label="misc-3", tooltip="parse_ws\nws_bot_proto"];
    ws_bot       [label="ws_bot"];
    gen_docs     [label="...english_documents"];
    osis_split   [label="osis_split_mapm"];

    // ── Edges ──

    // Google pipeline
    download_go  -> ds_go_csv;
    ds_go_csv    -> parse_go;
    parse_go     -> ds_parsed_plus;
    parse_go     -> ds_parsed_plain;

    // MAM-parsed consumers
    ds_parsed_plus  -> foi;
    ds_parsed_plus  -> mam_with_doc;
    ds_parsed_plus  -> mam_simple;
    ds_parsed_plus  -> misc_1;
    ds_parsed_plain -> tmpl_survey;
    ds_parsed_plain -> diff_wsgo;

    // MAM-with-doc outputs
    foi          -> ds_with_doc;
    mam_with_doc -> ds_with_doc;
    gen_docs     -> ds_with_doc;

    // MAM-simple pipeline
    mam_simple   -> ds_simple;
    ds_simple    -> misc_2;
    ds_simple    -> osis;
    misc_2       -> ds_sefaria;
    osis         -> ds_osis;
    osis_split   -> ds_osis;

    // Local out/ outputs
    tmpl_survey  -> ds_out;
    misc_1       -> ds_out;
    diff_wsgo    -> ds_out;
    diff_wsgo    -> ds_mamgo_auto;
    misc_3       -> ds_out;

    // Wikisource pipeline
    src_ws_live  -> download_ws;
    download_ws  -> ds_ws;
    ds_ws        -> diff_wsgo;
    ds_ws        -> misc_3;
    ws_bot       -> src_ws_live [style=dashed];

    // Sefaria download (standalone)
    download_sef -> ds_out;
}
