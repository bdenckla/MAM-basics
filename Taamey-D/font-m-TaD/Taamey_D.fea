  markClass tsere <anchor 300 0> @A_gen;
  markClass segol <anchor 310 0> @A_gen;
  markClass patax <anchor 272 0> @A_gen;
  markClass qamats <anchor 270 0> @A_gen;
  markClass qubuts <anchor 344 0> @A_gen;
  markClass qamatsqatan <anchor 270 0> @A_gen;
  markClass qamatsqatan.metegqatan <anchor 270 0> @A_gen;
  markClass qamatsqatan.hafukh <anchor 270 0> @A_gen;
  markClass qamatsqatan.metegqatanhafukh <anchor 270 0> @A_gen;
  markClass xatafsegol <anchor 426 0> @A_gen;
  markClass xatafpatax <anchor 389 0> @A_gen;
  markClass xatafqamats <anchor 389 0> @A_gen;
  markClass xatafqamats.qatan <anchor 389 0> @A_gen;
  markClass xatafqamats.qatanhafukh <anchor 389 0> @A_gen;
  markClass sheva <anchor 192 0> @A_gen;
  markClass shevana <anchor 217 0> @A_gen;
  markClass xiriq <anchor 192 0> @A_gen;
  markClass meteg <anchor 158 0> @A_gen;
  markClass xatafsegol_meteg <anchor 483 0> @A_gen;
  markClass xatafpatax_meteg <anchor 449 0> @A_gen;
  markClass xatafqamats_meteg <anchor 449 0> @A_gen;
  #
  pos mark atnax <anchor -152 0> mark @A_gen;
  pos mark tipxa <anchor -88 0> mark @A_gen;
  pos mark tevir <anchor -140 0> mark @A_gen;
  pos mark atnaxhafukh <anchor -152 0> mark @A_gen;
  pos mark munax <anchor -121 0> mark @A_gen;
  pos mark mahapakh <anchor -138 0> mark @A_gen;
  pos mark merkha <anchor -87 0> mark @A_gen;
  pos mark merkhakefula <anchor -184 0> mark @A_gen;
  pos mark darga <anchor -104 0> mark @A_gen;
  pos mark yeraxbenyomo <anchor -152 0> mark @A_gen;
  pos mark tsere <anchor -178 0> mark @A_gen;
  pos mark segol <anchor -188 0> mark @A_gen;
  pos mark patax <anchor -150 0> mark @A_gen;
  pos mark qamats <anchor -148 0> mark @A_gen;
  pos mark qubuts <anchor -222 0> mark @A_gen;
  pos mark qamatsqatan <anchor -148 0> mark @A_gen;
  pos mark qamatsqatan.metegqatan <anchor -317 0> mark @A_gen;
  pos mark qamatsqatan.hafukh <anchor -148 0> mark @A_gen;
  pos mark qamatsqatan.metegqatanhafukh <anchor -317 0> mark @A_gen;
  pos mark xatafsegol <anchor -304 0> mark @A_gen;
  pos mark xatafpatax <anchor -268 0> mark @A_gen;
  pos mark xatafqamats <anchor -267 0> mark @A_gen;
  pos mark xatafqamats.qatan <anchor -264 0> mark @A_gen;
  pos mark xatafqamats.qatanhafukh <anchor -264 0> mark @A_gen;
  pos mark sheva <anchor -70 0> mark @A_gen;
  pos mark shevana <anchor -97 0> mark @A_gen;
  pos mark xiriq <anchor -70 0> mark @A_gen;
  pos mark meteg <anchor -36 0> mark @A_gen;
  pos mark xatafsegol_meteg <anchor -362 0> mark @A_gen;
  pos mark xatafpatax_meteg <anchor -326 0> mark @A_gen;
  pos mark xatafqamats_meteg <anchor -326 0> mark @A_gen;
} mkmk0BlwChainGeneral;

lookup mkmk1BlwMarks {
  markClass meteg <anchor -44 0> @A45;
  markClass tipxa <anchor 8 0> @A45;
  markClass merkha <anchor 7 0> @A45;
  markClass darga <anchor 24 0> @A45;
  markClass sheva <anchor -10 0> @A45;  # See "Note on xiriq-then-sheva" below.
  markClass shevana <anchor 16 0> @A45;
  markClass munax <anchor 41 0> @A45;
  markClass [atnax atnaxhafukh yeraxbenyomo] <anchor 72 0> @A45;
  markClass mahapakh <anchor 58 0> @A45;
  markClass tevir <anchor 62 0> @A45;
  markClass merkhakefula <anchor 104 0> @A45;
  pos mark shevana <anchor -276 0> mark @A45;
  pos mark [sheva xiriq] <anchor -250 0> mark @A45;
  pos mark [tsere segol] <anchor -358 0> mark @A45;
  pos mark [patax patax.furtive qamats @qamats_qatans] <anchor -330 0> mark @A45;
  # It may seem pointless to include patax.furtive above, but there are dozens of words
  # where a patax.furtive is followed by a meteg, e.g. יָנ֥וּחַֽ, כֹּ֣חַֽ, נָרִ֥יעַֽ, רֹ֣עַֽ, שֹׁ֘מֵ֤עַֽ.
  pos mark qubuts <anchor -402 0> mark @A45;
  pos mark xatafsegol <anchor -484 0> mark @A45;
  pos mark @xataf_qamats_marks <anchor -446 0> mark @A45;
  pos mark xatafpatax <anchor -446 0> mark @A45;
} mkmk1BlwMarks;

lookup mkmk2BlwMarks {
  lookupflag UseMarkFilteringSet @blws;
  markClass meteg <anchor -104 0> @A53;
  markClass tipxa <anchor -52 0> @A53;
  markClass merkha <anchor -53 0> @A53;
  markClass munax <anchor -19 0> @A53;
  markClass atnax <anchor 12 0> @A53;
  markClass mahapakh <anchor -2 0> @A53;
  markClass tevir <anchor 2 0> @A53;
  #
  markClass shevana <anchor -44 0> @A71;
  markClass [sheva xiriq] <anchor -70 0> @A71;
  markClass tsere <anchor 38 0> @A71;
  markClass segol <anchor 48 0> @A71;
  markClass [patax qamats] <anchor 8 0> @A71;
  markClass qubuts <anchor 82 0> @A71;
  markClass xatafpatax <anchor 126 0> @A71;
  #
  pos mark meteg <anchor -298 0> mark @A53;
  pos mark tipxa <anchor -350 0> mark @A53;
  pos mark merkha <anchor -349 0> mark @A53;
  pos mark tevir <anchor -404 0> mark @A53;
  pos mark munax <anchor -383 0> mark @A53;
  pos mark mahapakh <anchor -400 0> mark @A53;
  pos mark atnax <anchor -414 0> mark @A53;
  #
  pos mark atnax <anchor -414 0> mark @A71;  # atnax-then-patax happens in the QUPO word mitachtat.
  #
  pos mark meteg <anchor -298 0> mark @A71;
} mkmk2BlwMarks;

lookup mkmk3BlwMarksMisc {
  # motivated by יָקֻ֑מוּ Isaiah 26:14
  markClass atnax <anchor -18 0> @A_qubuts_misc;
  markClass tipxa <anchor -82 0> @A_qubuts_misc;
  pos mark qubuts <anchor -402 0> mark @A_qubuts_misc;
  pos mark qamats <anchor -328 0> mark @A_qubuts_misc;
  pos mark segol <anchor -368 0> mark @A_qubuts_misc;
  pos mark patax <anchor -330 0> mark @A_qubuts_misc;
  pos mark tsere <anchor -358 0> mark @A_qubuts_misc;
} mkmk3BlwMarksMisc;

feature ss01 {
  sub xatafqamats by xatafqamats.qatan;
} ss01;

feature ss02 {
  sub qamatsqatan by qamatsqatan.metegqatan;
} ss02;

feature ss03 {
  sub qamatsqatan by qamatsqatan.hafukh;
} ss03;

feature ss04 {
  sub xatafqamats by xatafqamats.qatanhafukh;
} ss04;

feature ss05 {
  sub qamatsqatan by qamatsqatan.metegqatanhafukh;
} ss05;

feature ccmp {
  lookup ccmp00DeleteCgj;
  lookup ccmp01Misc;
  lookup ccmp02ShinDotAndSinDot;
  lookup ccmp03ShevaNaCompatibility;
  lookup ccmp03ProtectMamLowerDot;
  lookup ccmp03Dageshes;
  lookup ccmp03RestoreMamLowerDot;
  lookup ccmp04AlefToAlefCon;
  lookup ccmp05AlefXolam;
  lookup ccmp06JerusalemOrphans;
  lookup ccmp07TgTqSegTsiToTheirHlpVariants;
  lookup ccmp07DexiHlpToTopMeteg;
  lookup ccmp08Ger12ToGer12PreIfFollowedByTrueTg;
  lookup ccmp09AyinAlt;
  lookup ccmp10FurtivePatax;
  lookup ccmp11SpecialCaseFixups;
} ccmp;

feature mark {
  # Note that order doesn't matter here. I.e. order of lookup reference within a feature doesn't matter. Only order of lookup DEFINITION matters.
  lookup mark1BlwMarks;
  lookup mark2BalanceVyingBlwMarks;
  lookup mark3BalanceVyingTsereAndLd;
  lookup mark4AbvMarks;
  lookup mark4MoveXolamMaleOnVavWithDagesh;
  lookup mark5BalanceVyingAbvMarks;
  lookup mark6LiftReviaAboveRafe;
  lookup mark7MoveDageshNextToFinalNun;
  lookup mark8MoveDageshIntoAyinCounter;
} mark;

feature mkmk {
  lookup mkmk0BlwChainGeneral;
  lookup mkmk1BlwMarks;
  lookup mkmk2BlwMarks;
  lookup mkmk3BlwMarksMisc;
  lookup mkmk4AbvMarks;
} mkmk;

feature kern {
  lookup kern1AddThin;
  lookup kern2AddThin;
} kern;

########
# Note on xiriq-then-sheva
########
# The combo xiriq-then-sheva occurs in UXLC in the word תִּ͏ְירָא֑וּם, in D 3:22.
# Visually, it has xiriq-then-sheva (xiriq to the right of sheva) under tav with dagesh.
# Logically, it is encoded by UXLC as tav, dagesh, xiriq, CGJ, sheva.

########
# Note on joiner removal
########
# ccmp00DeleteCgj deletes every CGJ (U+034F). A CGJ's one job, keeping the marks around it in
# their encoded order, is done by the shaper's normalization before any lookup runs; left in
# the glyph stream, it only hides the marks on each side of it from the lookups that follow.
# Until 2026-10-27, five rules of the form "sub cgj x by x" and "sub x cgj by x" removed it in
# the five contexts the corpus has, listed below, because the deletion form "sub cgj by;" was
# taken not to compile. FontForge 20251009 compiles "sub cgj by NULL;", the feature-file
# specification's form, into a multiple substitution with no output glyph, which HarfBuzz and
# Uniscribe treat as a deletion although the OpenType specification asks for a sequence of at
# least one glyph.
# A ZWJ (U+200D) is not deleted: ccmp01Misc reads the xataf-ZWJ-meteg sequences, and the three
# UXLC atoms that hold a mark order with a ZWJ rather than a CGJ are left as they are.
# The letters used in the notes below:
#    in LA[UO]c[IE]: L=lamed, A=qamats or patax, U=under-accent, O=over-accent, c=CGJ,
#    E=sheva, I=xiriq;
#    in QUcPO: Q=qamats, U=under-accent, c=CGJ, P=patax, O=over-accent.
# Here "under-accent" & "over-accent" mean what "below-accent" & "above-accent" mean elsewhere.
# The five contexts the old rules covered, and what they gave:
#    1: LAUcI, LAOcI, or LAcIO, in Jerusalem words, giving LAUI, LAOI, or LAIO
#    2: LAUcE, LAOcE, or LAcEO, in Jerusalem words ending in -ah, giving LAUE, LAOE, or LAEO
#    3: QUcPO, in mitachat & panay, giving QUPO
#    4: UcM, an under-accent, CGJ, meteg, giving UM
#    5: McV, meteg, CGJ, vowel, the "early meteg", giving MV

########
# Note on the general below-mark chain
########
# mkmk0BlwChainGeneral, added on 2026-10-27, lets any below mark hang off the previous one.
# Before it, only the pairs that mkmk1BlwMarks and mkmk2BlwMarks name were chained, and those
# were the corpus's pairs: a vowel then an accent or meteg, one of six accents then another of
# them or meteg, and a vowel after an atnax or a meteg. Any other order, such as the
# accent-then-vowel of BHL's Appendix A forms at Psalms 31:24 and Malachi 2:17, left both
# marks at the letter's centre anchor, on top of each other. Measured with HarfBuzz 14.3 on
# every ordered pair of the 24 below marks on each of the 27 letters, 7,039 of the 14,904
# letter-pair cells collided before and 256 after, all 256 with a prepositive dexi or yetiv,
# as before. The lookups that run after it keep their own gaps and scoots for the pairs they
# name, since a later mark-to-mark attachment replaces an earlier one.

########
# Note on mark2BalanceVyingBlwMarks
########
# This lookup answers the question:
#
#    Now that we've positioned bvoms relative to base,
#    i.e. now that we've run mark1BlwMarks,
#    if there is more than one below-mark,
#    how much further "back" (to the right) should we scoot the 1st bvom
#    to make room for the additional below-mark(s)?
#
# Like, let's say we have tsere and then merkha.
# Now that we've positioned tsere relative to base,
# how much further "back" (to the right) should we scoot tsere
# to make room for merkha?

########
# Note on orphans
########
# The patterns used to identify orphans catch all of the following cases:
#    LAV = LA[IE] = LAI, LAE
#    LAXV = LA[UO][IE] = LAUI, LAOI, LAUE, LAOE
#    LAVX = LA[IE][UO] = LAIU, LAIO, LAEU, LAEO
# LAVU cases should not exist, since there is no reason, visual or logical, that
# the under-accent should come last.
# I.e. the only patterns that make sense are LAV, LAUV, LAOV, & LAVO.
# I.e. the only ambiguity in encoding is between LAOV & LAVO.

########
# Note on Ger12Pre
########
# Ger12 = geresh acc. (Ger1) or gershayim acc. (Ger2)
# TrueTg = "true" (i.e. prepositive, i.e. non-helper) telisha gedolah.
# We assume this lookup is applied only after telishagedola.hlp has been distinguished from telishagedola.
# I.e. we want the Ger12 accents to stay as they are if they are followed by telishagedola.hlp.
# Or, another way of putting it is, we only want the Ger12 accents to become prepositive if they
# are followed by (true, prepositive, non-helper) telisha gedolah.

########
# Note on top meteg
########
# A dexi stress helper, i.e. a second dexi, on the first letter of the stressed syllable,
# is drawn with the glyph topmeteg. The prepositive dexi, on the first letter, is drawn
# with the glyph dexi.
# topmeteg is a vertical bar like meteg, but with zaqefgadol's length and height:
# it is zaqefgadol's bar, moved so that it is centred on the glyph's origin.
# Since topmeteg is in @abv_ims, it attaches above the letter as zaqefgadol does
# (@A23_impo), and mark5BalanceVyingAbvMarks treats it as it treats zaqefgadol.
# As with telishagedola.hlp, the helper is recognized by position: a dexi whose letter
# follows another letter, ignoring marks other than dexi. A space or maqaf is not a
# letter, so a dexi on the first letter after either is never taken for a helper.
# A lone dexi that is not on the first letter (an unpaired helper) is also drawn
# with topmeteg.

########
# Note on missing dagesh compositions
########
# The following dagesh compositions are missing, by design: xet, mem sofit, nun sofit, ayin, & tsadi sofit.
# Such a dagesh is rare in practice.
# The combo xet dagesh exists in UXLC in מַחֲּמַדִּ֑ים in Song 5:16.
# The pointed ketiv הִןֵּ֤ at Isaiah 54:16 has nun sofit dagesh (hbofonts issue 123).
# The pointed ketiv שָׁםָּ֯ in the MAM documentation note on 2 Samuel 21:12 has mem sofit
# with qamats and dagesh (hbofonts issue 122).
# The pointed ketiv וּבַעְּפֹלִ֔ים in the MAM documentation note on Deuteronomy 28:27 has
# ayin with sheva and dagesh.
# With no composition, such a dagesh remains a mark of @A4_bvoms: it is centred in xet and in
# mem sofit; on nun sofit, mark7MoveDageshNextToFinalNun moves it next to the stem;
# and in ayin, mark8MoveDageshIntoAyinCounter moves it off the left arm into the counter.

########
# Note on Masorah circle
########
# The Masorah circle (masoracircle) is in @A23_impo, so it is centred above
# its letter, as an impositive accent is. In MAM it appears not in the
# text but in documentation notes, such as the note on 2 Samuel 5:2
# (hbofonts issue 122). In those notes it never shares a letter with
# another above mark, so no lookup moves it aside for one.
# A circle on a character with no @A23_impo anchor stays unattached, centred
# on that character's left edge. In the note on Jeremiah 50:29 the character
# is an opening bracket, so the circle stays between the brackets.
# In the note on 2 Samuel 21:12 a circle shares a mem sofit with qamats and dagesh;
# see "Note on missing dagesh compositions".

########
# Note on unrelated rules thrown together
########
# In general we throw a lot of unrelated rules together in the same lookup
# if in practice those rules don't interfere, even if theoretically they could interfere.
# I'm not sure what performance benefit, if any, this strategy has, but my unsubstantiated guess
# was that it was a good idea.

########
# Note on things we used to do in this file
########
#
# We used to do the following, due to shin dot:
#    lookup kernAddThin3 {
#      lookupflag UseMarkFilteringSet @xolam_star;
#      pos [yod yoddagesh yoddagesh.xazaq lamed lameddagesh lameddagesh.xazaq]' <100 0 100 0> @xolam_star [trueshin trueshindagesh trueshindagesh.xazaq];
#    } kernAddThin3;
#
# We used to customize the trueshin family's abv-prepo anchor to be 1492 (width + 200) instead of 1292 (width)
# to avoid collision with the shin dot that used to be part of the trueshin family.
#
# We used to customize the sin family's abv-popo anchor to -100 instead of 0
# to avoid collision with the sin dot that used to be part of the sin family.
#
# On trueshin, we used to lift up gereshacc.pre by 125 when it appeared (as it only does) with telishagedola
# to avoid collision with the shin dot that used to be part of the trueshin family. This was the code:
#
#    pos trueshin qubuts gereshacc.pre' <0 125 0 0> telishagedola;
#
# (The tg followed suit, i.e. automatically also lifted up, due to mkmk, at least in HarfBuzz.
# I think I saw it NOT follow suit on Windows (DirectWrite).)
