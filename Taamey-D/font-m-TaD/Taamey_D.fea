languagesystem hebr dflt;

lookup ccmp00DeleteCgj {  # See "Note on joiner removal"
  sub cgj by NULL;
} ccmp00DeleteCgj;

lookup ccmp01Misc {
  sub xatafsegol zerojoin meteg by xatafsegol_meteg;
  sub xatafpatax zerojoin meteg by xatafpatax_meteg;
  sub xatafqamats zerojoin meteg by xatafqamats_meteg;  # does not occur in UXLC
  # since xqamats-zwj-mtg does not occur in UXLC, we don't bother having a qatan version
  #
  sub vav xolam by vavxolam;
  #
  sub finalkaf sheva by finalkafsheva;  # finalkaf dagesh sheva stays as-is
  sub finalkaf qamats by finalkafqamats;  # finalkaf dagesh qamats stays as-is
} ccmp01Misc;

@dots_for_shinbase = [shindot sindot];

lookup ccmp02ShinDotAndSinDot {
  lookupflag UseMarkFilteringSet @dots_for_shinbase;
  sub shin shindot by trueshin;
  sub shin sindot by sin;
  sub shindagesh shindot by trueshindagesh;
  sub shindagesh sindot by sindagesh;
  sub shindagesh.xazaq shindot by trueshindagesh.xazaq;
  sub shindagesh.xazaq sindot by sindagesh.xazaq;
} ccmp02ShinDotAndSinDot;

@dagesh_n_dageshxazaq = [dagesh dageshxazaq lowerdot];

lookup ccmp03ShevaNaCompatibility {
  sub sheva lowerdot by shevana;
} ccmp03ShevaNaCompatibility;

@legacy_vav_dagesh_lowerdot = [dagesh lowerdot];

lookup ccmp03ProtectMamLowerDot {
  lookupflag UseMarkFilteringSet @legacy_vav_dagesh_lowerdot;
  sub vav dagesh lowerdot' lamed by lowerdot.no_xazaq;
} ccmp03ProtectMamLowerDot;

lookup ccmp03Dageshes {  # See Note on missing dagesh compositions
  lookupflag UseMarkFilteringSet @dagesh_n_dageshxazaq;
  sub alef dagesh by alefmapiq;
  sub bet dagesh by betdagesh;
  sub gimel dagesh by gimeldagesh;
  sub dalet dagesh by daletdagesh;
  sub he dagesh by hemapiq;
  sub vav dagesh by vavdou;
  sub zayin dagesh by zayindagesh;
  sub tet dagesh by tetdagesh;
  sub yod dagesh by yoddagesh;
  sub finalkaf dagesh by finalkafdagesh;
  sub kaf dagesh by kafdagesh;
  sub lamed dagesh by lameddagesh;
  sub mem dagesh by memdagesh;
  sub nun dagesh by nundagesh;
  sub samekh dagesh by samekhdagesh;
  sub finalpe dagesh by finalpedagesh;
  sub pe dagesh by pedagesh;
  sub tsadi dagesh by tsadidagesh;
  sub qof dagesh by qofdagesh;
  sub resh dagesh by reshdagesh;
  sub shin dagesh by shindagesh;
  sub trueshin dagesh by trueshindagesh;
  sub sin dagesh by sindagesh;
  sub tav dagesh by tavdagesh;
  #
  sub bet dagesh lowerdot by betdagesh.xazaq;
  sub gimel dagesh lowerdot by gimeldagesh.xazaq;
  sub dalet dagesh lowerdot by daletdagesh.xazaq;
  sub vav dagesh lowerdot by vavdagesh.xazaq;
  sub zayin dagesh lowerdot by zayindagesh.xazaq;
  sub tet dagesh lowerdot by tetdagesh.xazaq;
  sub yod dagesh lowerdot by yoddagesh.xazaq;
  sub finalkaf dagesh lowerdot by finalkafdagesh.xazaq;
  sub kaf dagesh lowerdot by kafdagesh.xazaq;
  sub lamed dagesh lowerdot by lameddagesh.xazaq;
  sub mem dagesh lowerdot by memdagesh.xazaq;
  sub nun dagesh lowerdot by nundagesh.xazaq;
  sub samekh dagesh lowerdot by samekhdagesh.xazaq;
  sub finalpe dagesh lowerdot by finalpedagesh.xazaq;
  sub pe dagesh lowerdot by pedagesh.xazaq;
  sub tsadi dagesh lowerdot by tsadidagesh.xazaq;
  sub qof dagesh lowerdot by qofdagesh.xazaq;
  sub resh dagesh lowerdot by reshdagesh.xazaq;
  sub shin dagesh lowerdot by shindagesh.xazaq;
  sub trueshin dagesh lowerdot by trueshindagesh.xazaq;
  sub sin dagesh lowerdot by sindagesh.xazaq;
  sub tav dagesh lowerdot by tavdagesh.xazaq;
  #
  sub bet dageshxazaq by betdagesh.xazaq;
  sub gimel dageshxazaq by gimeldagesh.xazaq;
  sub dalet dageshxazaq by daletdagesh.xazaq;
  sub vav dageshxazaq by vavdagesh.xazaq;
  sub zayin dageshxazaq by zayindagesh.xazaq;
  sub tet dageshxazaq by tetdagesh.xazaq;
  sub yod dageshxazaq by yoddagesh.xazaq;
  sub finalkaf dageshxazaq by finalkafdagesh.xazaq;
  sub kaf dageshxazaq by kafdagesh.xazaq;
  sub lamed dageshxazaq by lameddagesh.xazaq;
  sub mem dageshxazaq by memdagesh.xazaq;
  sub nun dageshxazaq by nundagesh.xazaq;
  sub samekh dageshxazaq by samekhdagesh.xazaq;
  sub finalpe dageshxazaq by finalpedagesh.xazaq;
  sub pe dageshxazaq by pedagesh.xazaq;
  sub tsadi dageshxazaq by tsadidagesh.xazaq;
  sub qof dageshxazaq by qofdagesh.xazaq;
  sub resh dageshxazaq by reshdagesh.xazaq;
  sub shin dageshxazaq by shindagesh.xazaq;
  sub trueshin dageshxazaq by trueshindagesh.xazaq;
  sub sin dageshxazaq by sindagesh.xazaq;
  sub tav dageshxazaq by tavdagesh.xazaq;
  #
  sub dagesh lowerdot by dageshxazaq;
} ccmp03Dageshes;

lookup ccmp03RestoreMamLowerDot {
  sub lowerdot.no_xazaq by lowerdot;
} ccmp03RestoreMamLowerDot;

@blw_ims = [atnax tipxa tevir atnaxhafukh munax mahapakh merkha merkhakefula darga yeraxbenyomo];
@abv_ims = [
  jsvarika
  telishagedola.hlp
  segolta.hlp telishaqetana.hlp pashta.hlp tsinor.hlp zarqahlp
  zaqefqatan zaqefgadol
  topmeteg
  gereshacc gershayimacc
  shalshelet revia qarneypara pazer qadma ole iluy];
@qamats_qatans = [qamatsqatan qamatsqatan.metegqatan qamatsqatan.hafukh qamatsqatan.metegqatanhafukh];
@xataf_qamats_marks = [xatafqamats xatafqamats.qatan xatafqamats.qatanhafukh];
@wide_vows = [tsere segol patax qamats qubuts @qamats_qatans];  # wide but not xataf
@xatafs = [xatafsegol xatafpatax @xataf_qamats_marks];
@blw_vows = [@wide_vows @xatafs sheva shevana xiriq];
@xolam_star = [xolam xolamxfv];
@vows = [@blw_vows @xolam_star];
@mics = [xatafsegol_meteg xatafpatax_meteg xatafqamats_meteg];  # mic = meteg inside [of] xataf [vowel]
@vows_n_mics = [@vows @mics];
@shinfamily = [shin shindagesh shindagesh.xazaq trueshin trueshindagesh trueshindagesh.xazaq trueshingereshtg sin sindagesh sindagesh.xazaq];
@finalkaffamily = [finalkaf finalkafdagesh finalkafdagesh.xazaq finalkafsheva finalkafqamats];
@letters = [
  alef alefmapiq alef.xolam alef.con
  bet betdagesh betdagesh.xazaq
  gimel gimeldagesh gimeldagesh.xazaq
  dalet daletdagesh daletdagesh.xazaq
  he hemapiq
  vav vavxolam vavdou vavdagesh.xazaq
  zayin zayindagesh zayindagesh.xazaq
  xet
  tet tetdagesh tetdagesh.xazaq
  yod yoddagesh yoddagesh.xazaq
  @finalkaffamily
  kaf kafdagesh kafdagesh.xazaq
  lamed lameddagesh lameddagesh.xazaq
  finalmem
  mem memdagesh memdagesh.xazaq
  finalnun
  nun nundagesh nundagesh.xazaq
  samekh samekhdagesh samekhdagesh.xazaq
  ayin ayin.alt
  finalpe finalpedagesh finalpedagesh.xazaq
  pe pedagesh pedagesh.xazaq
  finaltsadi
  tsadi tsadidagesh tsadidagesh.xazaq
  qof qofdagesh qofdagesh.xazaq
  resh reshdagesh reshdagesh.xazaq
  @shinfamily
  tav tavdagesh tavdagesh.xazaq
  dottedcircle];

lookup ccmp04AlefToAlefCon { # XXX vavdou not always a shuruq; could be a vav-as-con with a dagesh
  lookupflag UseMarkFilteringSet @vows_n_mics;
  sub alef' [@vows_n_mics vavxolam vavdou] by alef.con;
} ccmp04AlefToAlefCon;

lookup AlefXolam {
  sub alef by alef.xolam;
  sub xolam by xolam.invis;
} AlefXolam;

@xolam_solo = [xolam];

lookup ccmp05AlefXolam {
  lookupflag UseMarkFilteringSet @xolam_solo;
  sub xolam' lookup AlefXolam alef' lookup AlefXolam;
  # Read as follows:
  # sub xolam' (lookup AlefXolam) alef' (lookup AlefXolam);
} ccmp05AlefXolam;

@blw_vows_n_mtg = [@blw_vows meteg];
@blws = [@blw_ims @blw_vows_n_mtg @mics];  # not really all belows; missing prepos (yetiv & dexi)
@blw_wides = [@blw_ims @wide_vows @xatafs @mics];
@narlets = [gimel gimeldagesh gimeldagesh.xazaq vav vavdou vavdagesh.xazaq vavxolam zayin zayindagesh zayindagesh.xazaq yod yoddagesh yoddagesh.xazaq finalnun nun nundagesh nundagesh.xazaq];
@unarlets = [vav vavdou vavdagesh.xazaq vavxolam yod yoddagesh yoddagesh.xazaq];  # ultra-narrow letters (subset of narrows)
@rtdesc_finals = [@finalkaffamily finalnun finalpe finalpedagesh finalpedagesh.xazaq];

lookup kern1AddThin {  # XXX Symbolize the various integer literals in this lookup.
  lookupflag UseMarkFilteringSet @blws;
  pos @narlets' <100 0 100 0> @blw_wides       @narlets @blw_wides @blws;
  pos @unarlets' <100 0 100 0> @blw_wides      @unarlets @blws @blw_wides;
  pos @narlets' <100 0 100 0> @blws @blw_wides @narlets @blws;
  pos @narlets' <100 0 100 0> @blws @blw_wides @rtdesc_finals;
  pos @narlets' <100 0 100 0> @blws @blw_wides @letters @blw_wides @blws;
} kern1AddThin;

lookup kern2AddThin {  # XXX Symbolize the various integer literals in this lookup.
  lookupflag UseMarkFilteringSet @blws;
  pos @letters' <100 0 100 0> @blws @blws @narlets @blws @blws @blws;
  pos @letters' <100 0 100 0> @xatafs     @narlets @blw_wides @blws;
} kern2AddThin;

@patax_qamats_xiriq_sheva = [patax qamats xiriq sheva];

lookup ccmp06JerusalemOrphans {  # See "Note on orphans"
  lookupflag UseMarkFilteringSet @patax_qamats_xiriq_sheva;
  sub [patax qamats] xiriq' finalmem by xiriq.orphan;
  sub [patax qamats] sheva' mem by sheva.orphan;
} ccmp06JerusalemOrphans;

@tg_tq_seg_tsi = [telishagedola telishaqetana segolta pashta tsinor];

lookup ccmp07TgTqSegTsiToTheirHlpVariants {
  lookupflag UseMarkFilteringSet @tg_tq_seg_tsi;
  sub @letters @letters telishagedola' by telishagedola.hlp;
  sub @letters telishagedola @letters telishagedola' by telishagedola.hlp;
  sub telishaqetana' @letters by telishaqetana.hlp;
  sub segolta' @letters by segolta.hlp;
  sub pashta' @letters by pashta.hlp;
  sub tsinor' @letters by tsinor.hlp;
} ccmp07TgTqSegTsiToTheirHlpVariants;

@dexi_solo = [dexi];

lookup ccmp07DexiHlpToTopMeteg {  # See "Note on top meteg"
  lookupflag UseMarkFilteringSet @dexi_solo;
  sub @letters @letters dexi' by topmeteg;
  sub @letters dexi @letters dexi' by topmeteg;  # on the letter after the prepositive dexi's
} ccmp07DexiHlpToTopMeteg;

@gerstar_tg = [gershayimacc gereshacc telishagedola];

lookup ccmp08Ger12ToGer12PreIfFollowedByTrueTg {  # See "Note on Ger12Pre"
  lookupflag UseMarkFilteringSet @gerstar_tg;
  sub trueshin' gereshacc' telishagedola' by trueshingereshtg;
  sub gershayimacc' telishagedola by gershayimacc.pre;
  sub gereshacc' telishagedola by gereshacc.pre;
} ccmp08Ger12ToGer12PreIfFollowedByTrueTg;


lookup ccmp09AyinAlt {
  sub ayin' @blws @blws @blws by ayin.alt;  # עֶ֤֥בֶד in Deut. Decalogue
  sub ayin' @blws [atnaxhafukh yeraxbenyomo] by ayin.alt;
  sub ayin' @blws [zayin zayindagesh zayindagesh.xazaq] [patax qamats] by ayin.alt;
} ccmp09AyinAlt;

@furtive_patax_carriers = [xet ayin hemapiq he];
# Above, note that ayin.alt is not included.
# I suppose it wouldn't hurt to include it, except to perhaps be misleading,
# since ayin.alt never carries furtive patax.
# Above, note that plain he, i.e. he withough dagesh (mappiq) is included.
# Plain he should never carry furtive patax, but in UXLC (and presumably LC)
# it does.

@patax_solo = [patax];

lookup ccmp10FurtivePatax {
  lookupflag UseMarkFilteringSet @patax_solo;
  ignore sub patax' @letters;
  sub @letters       @furtive_patax_carriers patax' by patax.furtive;
  sub @letters patax @furtive_patax_carriers patax' by patax.furtive; # שְׁלִ֖יַחַ
  # Above, שְׁלִ֖יַחַ is likely an error in the LC, but we support it in order
  # to be able to render the error.
} ccmp10FurtivePatax;

lookup ccmp11SpecialCaseFixups {
  sub xet patax.furtive' tipxa by patax;  # "de-furtivize" the patax
  # Above is to support נִבְחַ֖ז with sub-runs נִבְחַ֖/ז.
  sub mem patax pashta' by pashta.hlp;
  # Above is to support פַּרְמַ֙שְׁתָּא֙ with sub-runs פַּרְמַ֙/שְׁ/תָּא֙.
  ignore sub dalet qamats dexi' @letters;
  sub dalet qamats dexi' by topmeteg;
  # Above two rules are to support אָ֭דָ֭ם with sub-runs אָ֭/דָ֭/ם.
  ignore sub nundagesh qamats dexi' he @letters;
  sub nundagesh qamats dexi' he by topmeteg;
  # Above two rules are to support וְ֭כַנָּ֭ה with sub-runs וְ֭/כַ/נָּ֭ה.
} ccmp11SpecialCaseFixups;

@orphans = [xiriq.orphan sheva.orphan];

lookup mark1BlwMarks {
  # XXX Do we need to support dotted circle in this way/at all? If we need to support dotted circle, add tests for it.
  #
  # finaltsadi seems to never take a bvom... xxx check this
  # finalmem takes bvoms in MAM documentation notes: qamats & dagesh in the note on
  # 2 Samuel 21:12 (hbofonts issue 122), and patah in the note on Isaiah 9:6.
  #
  markClass [dagesh dageshxazaq] <anchor 0 0> @A4_bvoms;  # only on a letter with no dagesh composition, rare in practice; see "Note on missing dagesh compositions"
  markClass shindot <anchor -330 0> @A4_bvoms;  # only for dottedcircle; symbolize?
  markClass sindot <anchor 357 0> @A4_bvoms;  # only for dottedcircle; symbolize?
  #
  markClass [sheva shevana xiriq meteg @wide_vows @xatafs @mics] <anchor 0 0> @A4_bvoms;
  markClass @orphans <anchor 0 0> @A4_orphans;
  #
  markClass [patax.furtive] <anchor -200 0> @A4_bvoms;  # XXX symbolize
  #
  pos base [alef alefmapiq alef.xolam alef.con] <anchor 524 0> mark @A4_bvoms;
  pos base [bet betdagesh betdagesh.xazaq] <anchor 483 0> mark @A4_bvoms;
  pos base [gimel gimeldagesh gimeldagesh.xazaq] <anchor 332 0> mark @A4_bvoms;
  pos base [dalet daletdagesh daletdagesh.xazaq] <anchor 439 0> mark @A4_bvoms;
  pos base [he hemapiq] <anchor 535 0> mark @A4_bvoms;
  pos base [vav vavdou vavdagesh.xazaq vavxolam] <anchor 255 0> mark @A4_bvoms;
  pos base [zayin zayindagesh zayindagesh.xazaq] <anchor 328 0> mark @A4_bvoms;
  pos base xet <anchor 532 0> mark @A4_bvoms;
  pos base [tet tetdagesh tetdagesh.xazaq] <anchor 507 0> mark @A4_bvoms;
  pos base [yod yoddagesh yoddagesh.xazaq] <anchor 232 0> mark @A4_bvoms;
  pos base @finalkaffamily <anchor 373 0> mark @A4_bvoms;
  pos base [kaf kafdagesh kafdagesh.xazaq] <anchor 471 0> mark @A4_bvoms;
  pos base [lamed lameddagesh lameddagesh.xazaq] <anchor 450 0> mark @A4_bvoms;
  pos base finalmem <anchor 502 0> mark @A4_bvoms;
  pos base [mem memdagesh memdagesh.xazaq] <anchor 547 0> mark @A4_bvoms;
  pos base finalnun <anchor -29 0> mark @A4_bvoms;
  pos base [nun nundagesh nundagesh.xazaq] <anchor 307 0> mark @A4_bvoms;
  pos base [samekh samekhdagesh samekhdagesh.xazaq] <anchor 519 0> mark @A4_bvoms;
  pos base [ayin ayin.alt] <anchor 460 0> mark @A4_bvoms;
  pos base [finalpe finalpedagesh finalpedagesh.xazaq] <anchor 443 0> mark @A4_bvoms;
  pos base [pe pedagesh pedagesh.xazaq] <anchor 456 0> mark @A4_bvoms;
  pos base [tsadi tsadidagesh tsadidagesh.xazaq] <anchor 484 0> mark @A4_bvoms;
  pos base [qof qofdagesh qofdagesh.xazaq] <anchor 618 0> mark @A4_bvoms;
  pos base [resh reshdagesh reshdagesh.xazaq] <anchor 441 0> mark @A4_bvoms;
  pos base @shinfamily <anchor 646 0> mark @A4_bvoms;
  pos base [tav tavdagesh tavdagesh.xazaq] <anchor 513 0> mark @A4_bvoms;
  pos base dottedcircle <anchor 575 0> mark @A4_bvoms;
  #
  pos base [lamed lameddagesh lameddagesh.xazaq] <anchor -96 0> mark @A4_orphans;  # XXX symbolize

  #
  markClass [tevir merkha merkhakefula atnax atnaxhafukh darga yeraxbenyomo mahapakh munax tipxa] <anchor 0 0> @A4_bvoms;
  markClass lowerdot <anchor 0 0> @A4_bvoms;
  markClass [yetiv dexi] <anchor 0 0> @A41_yetiv_dexi;
  #
  # alef, rather than alef.con, carries yetiv or dexi only in text without vowels, such as the
  # WLC verses on MAM-basics' accgram pages: Exodus 14:25, Psalms 56:10 and Proverbs 28:17.
  pos base [alef alefmapiq alef.con] <anchor 1048 0> mark @A41_yetiv_dexi;
  pos base [bet betdagesh betdagesh.xazaq] <anchor 967 0> mark @A41_yetiv_dexi;
  pos base [gimel gimeldagesh gimeldagesh.xazaq] <anchor 665 0> mark @A41_yetiv_dexi;
  pos base [dalet daletdagesh daletdagesh.xazaq] <anchor 879 0> mark @A41_yetiv_dexi;
  pos base [he hemapiq] <anchor 1071 0> mark @A41_yetiv_dexi;
  # vav below
  # zayin below
  pos base xet <anchor 1065 0> mark @A41_yetiv_dexi;
  pos base [tet tetdagesh tetdagesh.xazaq] <anchor 1015 0> mark @A41_yetiv_dexi;
  # yod below
  # no finalkaf family
  pos base [kaf kafdagesh kafdagesh.xazaq] <anchor 942 0> mark @A41_yetiv_dexi;
  pos base [lamed lameddagesh lameddagesh.xazaq] <anchor 901 0> mark @A41_yetiv_dexi;
  # no finalmem
  pos base [mem memdagesh memdagesh.xazaq] <anchor 1094 0> mark @A41_yetiv_dexi;
  # no finalnun
  # nun below
  pos base [samekh samekhdagesh samekhdagesh.xazaq] <anchor 1038 0> mark @A41_yetiv_dexi;
  pos base [ayin ayin.alt] <anchor 920 0> mark @A41_yetiv_dexi;
  # no final pe
  pos base [pe pedagesh pedagesh.xazaq] <anchor 912 0> mark @A41_yetiv_dexi;
  # no finaltsadi
  pos base [tsadi tsadidagesh tsadidagesh.xazaq] <anchor 968 0> mark @A41_yetiv_dexi;
  pos base [qof qofdagesh qofdagesh.xazaq] <anchor 997 0> mark @A41_yetiv_dexi;
  pos base [resh reshdagesh reshdagesh.xazaq] <anchor 883 0> mark @A41_yetiv_dexi;
  pos base @shinfamily <anchor 1292 0> mark @A41_yetiv_dexi;
  pos base [tav tavdagesh tavdagesh.xazaq] <anchor 1026 0> mark @A41_yetiv_dexi;
  pos base dottedcircle <anchor 1150 0> mark @A41_yetiv_dexi;
  #
  pos base [vav vavdou vavdagesh.xazaq vavxolam] <anchor 610 0> mark @A41_yetiv_dexi;
  pos base [zayin zayindagesh zayindagesh.xazaq] <anchor 756 0> mark @A41_yetiv_dexi;
  pos base [yod yoddagesh yoddagesh.xazaq] <anchor 564 0> mark @A41_yetiv_dexi;
  pos base [nun nundagesh nundagesh.xazaq] <anchor 714 0> mark @A41_yetiv_dexi;

} mark1BlwMarks;

lookup DexiRelBaseInWvohMtgCtxt {  # Wvoh: wide vowel or xataf (really wide) vowel
  # I.e. dexi relative to base in a context where both a Wvoh & meteg are preset.
  # The Wvoh & meteg can be in either order, i.e. the meteg can be early or normal.
  markClass dexi <anchor -50 0> @A68_dexi;  # XXX symbolize
  pos base [vav vavdou vavdagesh.xazaq vavxolam] <anchor 660 0> mark @A68_dexi;
  pos base [yod yoddagesh yoddagesh.xazaq] <anchor 614 0> mark @A68_dexi;
  pos base [lamed lameddagesh lameddagesh.xazaq] <anchor 901 0> mark @A68_dexi;
  pos base [ayin ayin.alt] <anchor 920 0> mark @A68_dexi;
} DexiRelBaseInWvohMtgCtxt;


@blws_incl_dexi = [@blws dexi];

lookup mark2BalanceVyingBlwMarks {  # See "Note on mark2BalanceVyingBlwMarks"
  lookupflag UseMarkFilteringSet @blws_incl_dexi;
  #
  # XXX Symbolize the various integer literals in this lookup.
  #
  pos finalkafqamats meteg' <107 0 0 0> munax;
  pos finalkafqamats @blw_ims' <0 0 0 0> [@blw_ims meteg];  # to prevent matching on cases below
  #
  # Below marks on finalnun are centred left of its descender, at -29.
  # Scooting the first of them back (to the right), as the cases below do, would push it into the descender.
  pos finalnun @blws' <0 0 0 0> @blws;
  #
  pos [qof qofdagesh qofdagesh.xazaq] xiriq' <125 0 0 0> [atnax tipxa mahapakh darga tevir];
  pos [qof qofdagesh qofdagesh.xazaq] xiriq' <75 0 0 0> [meteg munax merkha];
  pos [qof qofdagesh qofdagesh.xazaq] [tsere patax qamats]' <275 0 0 0> tevir;
  pos [qof qofdagesh qofdagesh.xazaq] [tsere patax qamats]' <200 0 0 0> [mahapakh darga];
  pos [qof qofdagesh qofdagesh.xazaq] [tsere patax qamats]' <140 0 0 0> [atnax ];
  pos [qof qofdagesh qofdagesh.xazaq] [tsere patax qamats]' <125 0 0 0> [tipxa meteg munax merkha];
  pos [qof qofdagesh qofdagesh.xazaq] segol' <200 0 0 0> [atnax];
  pos [qof qofdagesh qofdagesh.xazaq] segol' <125 0 0 0> [meteg munax merkha tipxa];
  pos [qof qofdagesh qofdagesh.xazaq] qubuts' <300 0 0 0> [tevir mahapakh darga];
  pos [qof qofdagesh qofdagesh.xazaq] qubuts' <200 0 0 0> [atnax];
  pos [qof qofdagesh qofdagesh.xazaq] qubuts' <125 0 0 0> [meteg munax merkha tipxa];
  pos [qof qofdagesh qofdagesh.xazaq] @blw_vows' <350 0 0 0> @blws;
  pos [yod yoddagesh yoddagesh.xazaq] [tsere patax qamats segol qubuts]' <0 225 0 0> [qof qofdagesh qofdagesh.xazaq] [patax qamats qubuts] [tevir mahapakh darga];
  #
  pos @blw_vows' <298 0 0 0> @blws @blws;
  pos meteg' <319 0 0 0> @blws @blws;
  #
  pos [vav vavdou vavdagesh.xazaq vavxolam] @blw_vows' <127 0 0 0> @blws dexi;
  pos [vav vavdou vavdagesh.xazaq vavxolam] meteg' <213 0 0 0> @blws dexi;
  pos [@wide_vows @xatafs] meteg dexi' lookup DexiRelBaseInWvohMtgCtxt;
  pos meteg [@wide_vows @xatafs] dexi' lookup DexiRelBaseInWvohMtgCtxt;
  pos @mics dexi' lookup DexiRelBaseInWvohMtgCtxt;
  #
  pos @blw_vows' <50 0 0 0> @blws dexi;
  pos meteg' <136 0 0 0> @blws dexi;
  #
  pos @blw_vows' <150 0 0 0> @blws;
  pos @blw_ims' <150 0 0 0> [@blw_ims meteg];
  pos meteg' <176 0 0 0> shevana;
  pos meteg' <150 0 0 0> [sheva xiriq];
  pos meteg' <272 0 0 0> @wide_vows;
  pos meteg' <383 0 0 0> @xatafs;
  pos meteg' <170 0 0 0> @blws;
  #
  # A chain head that no rule above matched, such as an accent before a vowel, is scooted
  # back as a vowel head is: by 298 before two more below marks and by 150 before one.
  pos @blws' <298 0 0 0> @blws @blws;
  pos @blws' <150 0 0 0> @blws;
} mark2BalanceVyingBlwMarks;

lookup mark3BalanceVyingTsereAndLd {
  pos tsere' <200 0 0 0> lowerdot' <-200 0 0 0>;
} mark3BalanceVyingTsereAndLd;

lookup mark4AbvMarks {  # XXX Symbolize the various integer literals in this lookup.
  markClass @xolam_star <anchor -212 0> @A20_xolam;

  markClass segolta <anchor -50 0> @A30_popo;
  markClass telishaqetana <anchor -81 0> @A30_popo;
  markClass tsinor <anchor -93 0> @A30_popo;
  markClass pashta <anchor -191 0> @A30_popo;
  #
  markClass telishagedola <anchor 25 0> @A27_prepo;
  markClass [gereshmuqdam gereshacc.pre gershayimacc.pre] <anchor 75 0> @A27_prepo;
  #
  markClass [@abv_ims upperdot rafe masoracircle] <anchor 0 0> @A23_impo;  # See "Note on Masorah circle"
  #
  #
  # Default & custom xolam positioning
  #
  pos base @letters <anchor -50 0> mark @A20_xolam;
  pos base [vav vavdou vavdagesh.xazaq vavxolam] <anchor -118 0> mark @A20_xolam;
  pos base [zayin zayindagesh zayindagesh.xazaq] <anchor -75 0> mark @A20_xolam;
  pos base [yod yoddagesh yoddagesh.xazaq] <anchor -150 0> mark @A20_xolam;
  pos base [lamed lameddagesh lameddagesh.xazaq] <anchor -213 -50> mark @A20_xolam;
  #
  # Default & custom popo positioning.
  #
  pos base @letters <anchor 0 0> mark @A30_popo;
  pos base vavxolam <anchor -75 0> mark @A30_popo;  # -75 due to xolam male dot in vavxolam
  pos base [lamed lameddagesh lameddagesh.xazaq] <anchor -300 0> mark @A30_popo;  # -300 due to ascender
  #
  # Only impo, no prepo
  #
  pos base @finalkaffamily <anchor 423 0> mark @A23_impo;
  pos base finalmem <anchor 502 0> mark @A23_impo;
  pos base finalnun <anchor 229 0> mark @A23_impo;
  pos base [finalpe finalpedagesh finalpedagesh.xazaq] <anchor 443 0> mark @A23_impo;
  pos base finaltsadi <anchor 495 0> mark @A23_impo;
  #
  # prepo & impo
  #
  pos base [alef alef.xolam alefmapiq alef.con] <anchor 1048 0> mark @A27_prepo <anchor 524 0> mark @A23_impo;
  pos base [bet betdagesh betdagesh.xazaq] <anchor 967 0> mark @A27_prepo <anchor 483 0> mark @A23_impo;
  pos base [gimel gimeldagesh gimeldagesh.xazaq] <anchor 665 0> mark @A27_prepo <anchor 332 0> mark @A23_impo;
  pos base [dalet daletdagesh daletdagesh.xazaq] <anchor 879 0> mark @A27_prepo <anchor 439 0> mark @A23_impo;
  pos base [he hemapiq] <anchor 1071 0> mark @A27_prepo <anchor 535 0> mark @A23_impo;
  pos base [vav vavdou vavdagesh.xazaq vavxolam] <anchor 510 0> mark @A27_prepo <anchor 255 0> mark @A23_impo;
  pos base [zayin zayindagesh zayindagesh.xazaq] <anchor 656 0> mark @A27_prepo <anchor 328 0> mark @A23_impo;
  pos base xet <anchor 1065 0> mark @A27_prepo <anchor 532 0> mark @A23_impo;
  pos base [tet tetdagesh tetdagesh.xazaq] <anchor 1015 0> mark @A27_prepo <anchor 507 0> mark @A23_impo;
  pos base [yod yoddagesh yoddagesh.xazaq] <anchor 464 0> mark @A27_prepo <anchor 232 0> mark @A23_impo;
  pos base [kaf kafdagesh kafdagesh.xazaq] <anchor 942 0> mark @A27_prepo <anchor 471 0> mark @A23_impo;
  # Note custom (600) below
  pos base [lamed lameddagesh lameddagesh.xazaq] <anchor 901 0> mark @A27_prepo <anchor 600 0> mark @A23_impo;  # custom (600)
  pos base [mem memdagesh memdagesh.xazaq] <anchor 1094 0> mark @A27_prepo <anchor 547 0> mark @A23_impo;
  pos base [nun nundagesh nundagesh.xazaq] <anchor 614 0> mark @A27_prepo <anchor 307 0> mark @A23_impo;
  pos base [samekh samekhdagesh samekhdagesh.xazaq] <anchor 1038 0> mark @A27_prepo <anchor 519 0> mark @A23_impo;
  pos base [ayin ayin.alt] <anchor 920 0> mark @A27_prepo <anchor 460 0> mark @A23_impo;
  pos base [pe pedagesh pedagesh.xazaq] <anchor 912 0> mark @A27_prepo <anchor 456 0> mark @A23_impo;
  pos base [tsadi tsadidagesh tsadidagesh.xazaq] <anchor 968 0> mark @A27_prepo <anchor 484 0> mark @A23_impo;
  pos base [qof qofdagesh qofdagesh.xazaq] <anchor 997 0> mark @A27_prepo <anchor 498 0> mark @A23_impo;
  pos base [resh reshdagesh reshdagesh.xazaq] <anchor 883 0> mark @A27_prepo <anchor 441 0> mark @A23_impo;
  pos base @shinfamily <anchor 1292 0> mark @A27_prepo <anchor 646 0> mark @A23_impo;
  pos base [tav tavdagesh tavdagesh.xazaq] <anchor 1026 0> mark @A27_prepo <anchor 513 0> mark @A23_impo;
  pos base dottedcircle <anchor 1150 0> mark @A27_prepo <anchor 575 0> mark @A23_impo;
} mark4AbvMarks;

lookup mark4MoveXolamMaleOnVavWithDagesh {
  lookupflag UseMarkFilteringSet @xolam_solo;
  #
  # On a vav, xolam (U+05B9) is a xolam male; xolamxfv (U+05BA) is the xolam xaser for vav.
  # ccmp01Misc draws a xolam male as vavxolam only when the xolam directly follows the vav.
  # HarfBuzz puts a dagesh before a xolam, whatever the encoded order, so on a vav with a
  # dagesh (vavdou) or a dagesh xazaq (vavdagesh.xazaq) the xolam stays a mark, and
  # mark4AbvMarks gives it xolamxfv's place, centred 94 units right of the vav's origin.
  # Move it right by 275 and down by 15, to match vavxolam, which shifts its vav 5.5 left and
  # centres its dot at 363.5, 15 units lower: 369 units right of its vav's origin.
  # Defined before mark5BalanceVyingAbvMarks, so with an above accent on the same vav,
  # that lookup attaches the xolam anew, where it attaches xolamxfv.
  # BHL has such a vav, as transcribed: in its Appendix A at Proverbs 24:25, and in its
  # marginal qere at Daniel 5:21. No qa-in input, and no word in MAM's or UXLC's word
  # lists, has one.
  # The mark filtering set skips other marks, so their order does not matter.
  #
  pos [vavdou vavdagesh.xazaq] xolam' <275 -15 0 0>;
} mark4MoveXolamMaleOnVavWithDagesh;

lookup XolamViesWithAbvAccOnNarLet {  # xolam_star vies with an above-accent on a narrow letter
  markClass @xolam_star <anchor -212 0> @A22_xolam;  # symbolize
  pos base [gimel gimeldagesh gimeldagesh.xazaq] <anchor -198 0> mark @A22_xolam;
  pos base [vav vavdou vavdagesh.xazaq vavxolam] <anchor -275 0> mark @A22_xolam;
  pos base [zayin zayindagesh zayindagesh.xazaq] <anchor -202 0> mark @A22_xolam;
  pos base [yod yoddagesh yoddagesh.xazaq] <anchor -298 0> mark @A22_xolam;
  pos base [nun nundagesh nundagesh.xazaq] <anchor -223 0> mark @A22_xolam;
  #
  pos base [dalet daletdagesh daletdagesh.xazaq] <anchor -91 0> mark @A22_xolam;
  pos base [resh reshdagesh reshdagesh.xazaq] <anchor -89 0> mark @A22_xolam;
  pos base [pe pedagesh pedagesh.xazaq] <anchor -74 0> mark @A22_xolam;
  pos base [ayin ayin.alt] <anchor -70 0> mark @A22_xolam;
} XolamViesWithAbvAccOnNarLet;

@vying_abv_marks = [@abv_ims @xolam_star gereshmuqdam pashta upperdot];

lookup mark5BalanceVyingAbvMarks {  # XXX Symbolize the various integer literals in this lookup.
  lookupflag UseMarkFilteringSet @vying_abv_marks;
  pos [gimel gimeldagesh gimeldagesh.xazaq vav vavdou vavdagesh.xazaq vavxolam zayin zayindagesh zayindagesh.xazaq yod yoddagesh yoddagesh.xazaq nun nundagesh nundagesh.xazaq]
    @xolam_star' lookup XolamViesWithAbvAccOnNarLet
    @abv_ims;
  pos [dalet daletdagesh daletdagesh.xazaq resh reshdagesh reshdagesh.xazaq pe pedagesh pedagesh.xazaq ayin ayin.alt]
    @xolam_star' lookup XolamViesWithAbvAccOnNarLet
    [zarqahlp tsinor.hlp segolta.hlp];
  #
  # To avoid collision with revia, scoot the gereshmuqdam "back" (to the right) 100 units.
  # I did not include vav in the letter class below because in practice it does not appear with revia mugrash. XXX check this
  # The pattern below could be thrown off by xolam_star being in the mark filtering set, but in practice it is not thrown off, i.e. xolam_star is not present in those cases.
  #
  pos [gimel gimeldagesh gimeldagesh.xazaq zayin zayindagesh zayindagesh.xazaq yod yoddagesh yoddagesh.xazaq nun nundagesh nundagesh.xazaq] gereshmuqdam' <100 0 0 0> revia;
  #
  # To avoid collision with the sin dot, scoot pashta "forward" (to the left).
  #
  pos [sin sindagesh sindagesh.xazaq] pashta' <-75 0 0 0>;
  #
  # To avoid collision with the lamed ascender, lift up the qarneypara by 175 and scoot it "back" (to the right) by 50.
  #
  pos [lamed lameddagesh lameddagesh.xazaq] qarneypara' <50 175 0 0>;
  #
  # To avoid collision with upperdot, move the pashta a little down and a little "forward" (to the left).
  # We support both orders, upperdot-then-pashta and pashta-then-upperdot.
  #
  pos [nun vavdou vavdagesh.xazaq] upperdot pashta' <-50 -50 0 0>;
  pos [nun vavdou vavdagesh.xazaq] pashta' <-50 -50 0 0> upperdot;
  #
  pos upperdot' <-175 0 0 0> @abv_ims' <100 0 0 0>;
  pos @abv_ims' <100 0 0 0> upperdot' <-175 0 0 0>;
  #
  pos @abv_ims' <225 0 0 0> @abv_ims;
} mark5BalanceVyingAbvMarks;

@rafe_n_revia = [rafe revia];

lookup mark6LiftReviaAboveRafe {
  lookupflag UseMarkFilteringSet @rafe_n_revia;
  #
  # To avoid collision with a rafeh on the same letter, lift up the revia by 188,
  # the room the rafeh takes above a letter such as bet: a 94-unit gap plus a 94-unit bar.
  # The revia then clears the rafeh by 83, the gap it normally leaves above such a letter.
  # The mark filtering set skips other marks but never a letter, so only a rafeh and a revia
  # on the same letter match. HarfBuzz, like Unicode canonical order, puts the rafeh first.
  # In qa-in, only one atom has such a letter; qa-in records that atom as coming from MAM only.
  #
  pos rafe revia' <0 188 0 0>;
} mark6LiftReviaAboveRafe;

lookup mark7MoveDageshNextToFinalNun {
  lookupflag UseMarkFilteringSet @dagesh_n_dageshxazaq;
  #
  # A final nun has no dagesh composition (see "Note on missing dagesh compositions"),
  # so its dagesh attaches through @A4_bvoms, the class of the below marks,
  # at -29, left of the letter, 182 units from the stem.
  # Move the dagesh right by 76, leaving the 106 units that vavdou and nundagesh
  # leave between their dagesh and their stem.
  # The mark filtering set skips vowels and accents, so their order does not matter.
  #
  pos finalnun [dagesh dageshxazaq]' <76 0 0 0>;
} mark7MoveDageshNextToFinalNun;

lookup mark8MoveDageshIntoAyinCounter {
  lookupflag UseMarkFilteringSet @dagesh_n_dageshxazaq;
  #
  # An ayin has no dagesh composition (see "Note on missing dagesh compositions"),
  # so its dagesh attaches through @A4_bvoms, the class of the below marks,
  # at 460, where it touches the lower bulge of the ayin's left arm.
  # Move the dagesh right by 60 and up by 165, to the place in the counter between
  # the arms that is farthest from both, about 100 units from each.
  # Composed dagesh glyphs leave 68 to 213 units between their dagesh and their letter.
  # The mark filtering set skips vowels and accents, so their order does not matter.
  #
  pos ayin dagesh' <60 165 0 0>;
} mark8MoveDageshIntoAyinCounter;

# XXX what finals other than finalkaf take an accent and/or vowel?
# XXX what vowels other than qamats & sheva does finalkaf take? i.e. since finalkafqamats & finalkafsheva exist, does plain finalkaf take anything?


lookup mkmk4AbvMarks {  # XXX Symbolize the various integer literals in this lookup.
  markClass [telishagedola telishagedola.hlp] <anchor -151 0> @A57;
  markClass [zaqefqatan pazer] <anchor -75 0> @A57;
  markClass [gereshacc gershayimacc] <anchor -45 0> @A57;
  markClass revia <anchor 0 0> @A57;
  pos mark [zaqefqatan revia] <anchor -425 0> mark @A57;
  pos mark pazer <anchor -478 0> mark @A57;
  pos mark [gershayimacc gershayimacc.pre] <anchor -567 0> mark @A57;
  pos mark [gereshacc gereshacc.pre] <anchor -467 0> mark @A57;
} mkmk4AbvMarks;

lookup mkmk0BlwChainGeneral {
  # Every below mark hangs off the previous below mark, whatever their kinds, leaving the gap
  # that mkmk2BlwMarks leaves; the anchors come from each glyph's ink extents, held in
  # main_fill_in_template.py's _BELOW_INK table. mkmk1BlwMarks and mkmk2BlwMarks, defined
  # after this lookup, still re-attach the pairs they know, so this lookup only reaches the
  # pairs they do not. See "Note on the general below-mark chain".
  lookupflag UseMarkFilteringSet @blws;
  markClass atnax <anchor 274 0> @A_gen;
  markClass tipxa <anchor 210 0> @A_gen;
  markClass tevir <anchor 262 0> @A_gen;
  markClass atnaxhafukh <anchor 274 0> @A_gen;
