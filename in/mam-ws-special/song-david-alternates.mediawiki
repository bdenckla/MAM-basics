===שירת דוד בכתיבה שירית===

<קטע התחלה=כתיבה שירית/>{{תבנית:משתמש:Dovi/טעמי המקרא}}
וַיְדַבֵּ֤ר דָּוִד֙ לַיהֹוָ֔ה{{ר1}}אֶת־דִּבְרֵ֖י הַשִּׁירָ֣ה הַזֹּ֑את{{ר3}}בְּיוֹם֩ הִצִּ֨יל יְהֹוָ֥ה אֹת֛וֹ{{ר1}}מִכַּ֥ף כׇּל־אֹיְבָ֖יו וּמִכַּ֥ף שָׁאֽוּל׃{{ר4}}{{ר4}}וַיֹּאמַ֑ר{{ר4}}{{ר4}}יְהֹוָ֛ה{{ר1}}סַֽלְעִ֥י וּמְצֻדָתִ֖י וּמְפַלְטִי־לִֽי׃{{ר4}}אֱלֹהֵ֥י צוּרִ֖י אֶחֱסֶה־בּ֑וֹ{{ר1}}מָגִנִּ֞י וְקֶ֣רֶן יִשְׁעִ֗י{{ר2}}מִשְׂגַּבִּי֙ וּמְנוּסִ֔י{{ר2}}מֹשִׁעִ֕י מֵחָמָ֖ס תֹּשִׁעֵֽנִי׃{{ר4}}{{ר4}}מְהֻלָּ֖ל אֶקְרָ֣א יְהֹוָ֑ה{{ר1}}וּמֵאֹיְבַ֖י אִוָּשֵֽׁעַ׃{{ר4}}כִּ֥י אֲפָפֻ֖נִי מִשְׁבְּרֵי־מָ֑וֶת{{ר1}}נַחֲלֵ֥י בְלִיַּ֖עַל יְבַעֲתֻֽנִי׃{{ר4}}חֶבְלֵ֥י שְׁא֖וֹל סַבֻּ֑נִי{{ר1}}קִדְּמֻ֖נִי מֹ֥קְשֵׁי מָֽוֶת׃{{ר4}}בַּצַּר־לִי֙ אֶקְרָ֣א יְהֹוָ֔ה{{ר1}}וְאֶל־אֱלֹהַ֖י אֶקְרָ֑א{{ר3}}וַיִּשְׁמַ֤ע מֵהֵֽיכָלוֹ֙ קוֹלִ֔י{{ר1}}וְשַׁוְעָתִ֖י בְּאׇזְנָֽיו׃{{ר4}}{{ר4}}{{כו"ק|ותגעש|וַיִּתְגָּעַ֤שׁ}} וַתִּרְעַשׁ֙ הָאָ֔רֶץ{{ר1}}מוֹסְד֥וֹת הַשָּׁמַ֖יִם יִרְגָּ֑זוּ{{ר2}}וַיִּֽתְגָּעֲשׁ֖וּ כִּי־חָ֥רָה לֽוֹ׃{{ר4}}עָלָ֤ה עָשָׁן֙ בְּאַפּ֔וֹ{{ר1}}וְאֵ֥שׁ מִפִּ֖יו תֹּאכֵ֑ל{{ר2}}גֶּחָלִ֖ים בָּעֲר֥וּ מִמֶּֽנּוּ׃{{ר4}}וַיֵּ֥ט שָׁמַ֖יִם וַיֵּרַ֑ד{{ר1}}וַעֲרָפֶ֖ל תַּ֥חַת רַגְלָֽיו׃{{ר4}}וַיִּרְכַּ֥ב עַל־כְּר֖וּב וַיָּעֹ֑ף{{ר1}}וַיֵּרָ֖א עַל־כַּנְפֵי־רֽוּחַ׃{{ר4}}וַיָּ֥שֶׁת חֹ֛שֶׁךְ סְבִיבֹתָ֖יו סֻכּ֑וֹת{{ר1}}חַֽשְׁﬞרַת־מַ֖יִם עָבֵ֥י שְׁחָקִֽים׃{{ר4}}מִנֹּ֖גַהּ נֶגְדּ֑וֹ{{ר1}}בָּעֲר֖וּ גַּחֲלֵי־אֵֽשׁ׃{{ר4}}יַרְעֵ֥ם מִן־שָׁמַ֖יִם יְהֹוָ֑ה{{ר1}}וְעֶלְי֖וֹן יִתֵּ֥ן קוֹלֽוֹ׃{{ר4}}וַיִּשְׁלַ֥ח חִצִּ֖ים וַיְפִיצֵ֑ם{{ר1}}בָּרָ֖ק {{כו"ק|ויהמם|וַיָּהֹֽם}}׃{{ר4}}וַיֵּֽרָאוּ֙ אֲפִ֣קֵי יָ֔ם{{ר1}}יִגָּל֖וּ מֹסְד֣וֹת תֵּבֵ֑ל{{ר3}}בְּגַעֲרַ֣ת יְהֹוָ֔ה{{ר1}}מִנִּשְׁמַ֖ת ר֥וּחַ אַפּֽוֹ׃{{ר4}}{{ר4}}יִשְׁלַ֥ח מִמָּר֖וֹם יִקָּחֵ֑נִי{{ר1}}יַֽמְשֵׁ֖נִי מִמַּ֥יִם רַבִּֽים׃{{ר4}}יַצִּילֵ֕נִי מֵאֹיְבִ֖י עָ֑ז{{ר1}}מִשֹּׂ֣נְאַ֔י כִּ֥י אָמְצ֖וּ מִמֶּֽנִּי׃{{ר4}}יְקַדְּמֻ֖נִי בְּי֣וֹם אֵידִ֑י{{ר1}}וַיְהִ֧י יְהֹוָ֛ה מִשְׁעָ֖ן לִֽי׃{{ר4}}וַיֹּצֵ֥א לַמֶּרְחָ֖ב אֹתִ֑י{{ר1}}יְחַלְּצֵ֖נִי כִּי־חָ֥פֵֽץ בִּֽי׃{{ר4}}{{ר4}}יִגְמְלֵ֥נִי יְהֹוָ֖ה כְּצִדְקָתִ֑י{{ר1}}כְּבֹ֥ר יָדַ֖י יָשִׁ֥יב לִֽי׃{{ר4}}כִּ֥י שָׁמַ֖רְתִּי דַּרְכֵ֣י יְהֹוָ֑ה{{ר1}}וְלֹ֥א רָשַׁ֖עְתִּי מֵאֱלֹהָֽי׃{{ר4}}כִּ֥י כׇל־מִשְׁפָּטָ֖ו לְנֶגְדִּ֑י{{ר1}}וְחֻקֹּתָ֖יו לֹא־אָס֥וּר מִמֶּֽנָּה׃{{ר4}}וָאֶהְיֶ֥ה תָמִ֖ים ל֑וֹ{{ר1}}וָאֶשְׁתַּמְּרָ֖ה מֵעֲוֺנִֽי׃{{ר4}}וַיָּ֧שֶׁב יְהֹוָ֛ה לִ֖י כְּצִדְקָתִ֑י{{ר1}}כְּבֹרִ֖י לְנֶ֥גֶד עֵינָֽיו׃{{ר4}}עִם־חָסִ֖יד תִּתְחַסָּ֑ד{{ר1}}עִם־גִּבּ֥וֹר תָּמִ֖ים תִּתַּמָּֽם׃{{ר4}}עִם־נָבָ֖ר תִּתָּבָ֑ר{{ר1}}וְעִם־עִקֵּ֖שׁ תִּתַּפָּֽל׃{{ר4}}וְאֶת־עַ֥ם עָנִ֖י תּוֹשִׁ֑יעַ{{ר1}}וְעֵינֶ֥יךָ עַל־רָמִ֖ים תַּשְׁפִּֽיל׃{{ר4}}כִּֽי־אַתָּ֥ה נֵירִ֖י יְהֹוָ֑ה{{ר1}}וַיהֹוָ֖ה יַגִּ֥יהַּ חׇשְׁכִּֽי׃{{ר4}}כִּ֥י בְכָ֖ה אָר֣וּץ גְּד֑וּד{{ר1}}בֵּאלֹהַ֖י אֲדַלֶּג־שֽׁוּר׃{{ר4}}הָאֵ֖ל תָּמִ֣ים דַּרְכּ֑וֹ{{ר1}}אִמְרַ֤ת יְהֹוָה֙ צְרוּפָ֔ה{{ר2}}מָגֵ֣ן ה֔וּא לְכֹ֖ל הַֽחֹסִ֥ים בּֽוֹ׃{{ר4}}{{ר4}}כִּ֥י מִי־אֵ֖ל מִבַּלְעֲדֵ֣י יְהֹוָ֑ה{{ר1}}וּמִ֥י צ֖וּר מִֽבַּלְעֲדֵ֥י אֱלֹהֵֽינוּ׃{{ר4}}הָאֵ֥ל מָֽעוּזִּ֖י חָ֑יִל{{ר1}}וַיַּתֵּ֥ר תָּמִ֖ים {{כו"ק|דרכו|דַּרְכִּֽי}}׃{{ר4}}מְשַׁוֶּ֥ה {{כו"ק|רגליו|רַגְלַ֖י}} כָּאַיָּל֑וֹת{{ר1}}וְעַ֥ל בָּמֹתַ֖י יַעֲמִדֵֽנִי׃{{ר4}}מְלַמֵּ֥ד יָדַ֖י לַמִּלְחָמָ֑ה{{ר1}}וְנִחַ֥ת קֶשֶׁת־נְחוּשָׁ֖ה זְרֹעֹתָֽי׃{{ר4}}וַתִּתֶּן־לִ֖י מָגֵ֣ן יִשְׁעֶ֑ךָ{{ר1}}וַעֲנֹתְךָ֖ תַּרְבֵּֽנִי׃{{ר4}}תַּרְחִ֥יב צַעֲדִ֖י תַּחְתֵּ֑נִי{{ר1}}וְלֹ֥א מָעֲד֖וּ קַרְסֻלָּֽי׃{{ר4}}אֶרְדְּפָ֥ה אֹיְבַ֖י וָאַשְׁמִידֵ֑ם{{ר1}}וְלֹ֥א אָשׁ֖וּב עַד־כַּלּוֹתָֽם׃{{ר4}}וָאֲכַלֵּ֥ם וָאֶמְחָצֵ֖ם וְלֹ֣א יְקוּמ֑וּן{{ר1}}וַֽיִּפְּל֖וּ תַּ֥חַת רַגְלָֽי׃{{ר4}}וַתַּזְרֵ֥נִי חַ֖יִל לַמִּלְחָמָ֑ה{{ר1}}תַּכְרִ֥יעַ קָמַ֖י תַּחְתֵּֽנִי׃{{ר4}}וְאֹ֣יְבַ֔י תַּ֥תָּה לִּ֖י עֹ֑רֶף{{ר1}}מְשַׂנְאַ֖י וָאַצְמִיתֵֽם׃{{ר4}}יִשְׁע֖וּ וְאֵ֣ין מֹשִׁ֑יעַ{{ר1}}אֶל־יְהֹוָ֖ה וְלֹ֥א עָנָֽם׃{{ר4}}וְאֶשְׁחָקֵ֖ם כַּעֲפַר־אָ֑רֶץ{{ר1}}כְּטִיט־חוּצ֥וֹת אֲדִקֵּ֖ם אֶרְקָעֵֽם׃{{ר4}}וַֽתְּפַלְּטֵ֔נִי מֵרִיבֵ֖י עַמִּ֑י{{ר1}}תִּשְׁמְרֵ֙נִי֙ לְרֹ֣אשׁ גּוֹיִ֔ם{{ר2}}עַ֥ם לֹא־יָדַ֖עְתִּי יַעַבְדֻֽנִי׃{{ר4}}בְּנֵ֥י נֵכָ֖ר יִתְכַּחֲשׁוּ־לִ֑י{{ר1}}לִשְׁמ֥וֹעַ אֹ֖זֶן יִשָּׁ֥מְעוּ לִֽי׃{{ר4}}בְּנֵ֥י נֵכָ֖ר יִבֹּ֑לוּ{{ר1}}וְיַחְגְּר֖וּ מִמִּסְגְּרוֹתָֽם׃{{ר4}}{{ר4}}חַי־יְהֹוָ֖ה וּבָר֣וּךְ צוּרִ֑י{{ר1}}וְיָרֻ֕ם אֱלֹהֵ֖י צ֥וּר יִשְׁעִֽי׃{{ר4}}הָאֵ֕ל הַנֹּתֵ֥ן נְקָמֹ֖ת לִ֑י{{ר1}}וּמֹרִ֥יד עַמִּ֖ים תַּחְתֵּֽנִי׃{{ר4}}וּמוֹצִיאִ֖י מֵאֹֽיְבָ֑י{{ר1}}וּמִקָּמַי֙ תְּר֣וֹמְמֵ֔נִי{{ר2}}מֵאִ֥ישׁ חֲמָסִ֖ים תַּצִּילֵֽנִי׃{{ר4}}{{ר4}}עַל־כֵּ֛ן אֽוֹדְךָ֥ יְהֹוָ֖ה בַּגּוֹיִ֑ם{{ר1}}וּלְשִׁמְךָ֖ אֲזַמֵּֽר׃{{ר4}}{{כו"ק|מגדיל|מִגְדּ֖וֹל}} יְשׁוּע֣וֹת מַלְכּ֑וֹ{{ר1}}וְעֹֽשֶׂה־חֶ֧סֶד לִמְשִׁיח֛וֹ{{ר2}}לְדָוִ֥ד וּלְזַרְע֖וֹ עַד־עוֹלָֽם׃
