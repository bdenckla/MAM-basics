<קטע התחלה=סימן/>{{מ:פסוק|שמות|טו|א}}<קטע סוף=סימן/><קטע התחלה=א/>אָ֣ז {{נוסח|יָשִֽׁיר־מֹשֶׁה֩|2==א(ס),ל,ל1,ב,ש,ש1,ק3,ו (געיה בשי"ן){{ש}}בחלק מהדפוסים ובקורן הגעיה מלעיל ביו"ד <יָֽשִׁיר־מֹשֶׁה֩>}} וּבְנֵ֨י יִשְׂרָאֵ֜ל אֶת־הַשִּׁירָ֤ה הַזֹּאת֙ לַֽיהֹוָ֔ה וַיֹּאמְר֖וּ לֵאמֹ֑ר{{מ:ששש}}אָשִׁ֤ירָה {{נוסח|לַֽיהֹוָה֙|2=ל=לַֽיהֹוָה֙ בגעיה ימנית}} כִּֽי־גָאֹ֣ה גָּאָ֔ה{{מ:ששש}}ס֥וּס וְרֹכְב֖וֹ רָמָ֥ה בַיָּֽם׃<קטע סוף=א/>
{{מ:ששש}}<קטע התחלה=סימן/>{{מ:פסוק|שמות|טו|ב}}<קטע סוף=סימן/><קטע התחלה=ב/>עׇזִּ֤י וְזִמְרָת֙ יָ֔הּ וַֽיְהִי־לִ֖י לִֽישׁוּעָ֑ה{{מ:ששש}}זֶ֤ה אֵלִי֙ וְאַנְוֵ֔הוּ{{מ:ששש}}אֱלֹהֵ֥י אָבִ֖י וַאֲרֹמְמֶֽנְהוּ׃<קטע סוף=ב/>
{{מ:ששש}}<קטע התחלה=סימן/>{{מ:פסוק|שמות|טו|ג}}<קטע סוף=סימן/><קטע התחלה=ג/>יְהֹוָ֖ה אִ֣ישׁ מִלְחָמָ֑ה יְהֹוָ֖ה שְׁמֽוֹ׃<קטע סוף=ג/>
{{מ:ששש}}<קטע התחלה=סימן/>{{מ:פסוק|שמות|טו|ד}}<קטע סוף=סימן/><קטע התחלה=ד/>מַרְכְּבֹ֥ת פַּרְעֹ֛ה וְחֵיל֖וֹ יָרָ֣ה בַיָּ֑ם{{מ:ששש}}וּמִבְחַ֥ר שָֽׁלִשָׁ֖יו טֻבְּע֥וּ בְיַם־סֽוּף׃<קטע סוף=ד/>
{{מ:ששש}}<קטע התחלה=סימן/>{{מ:פסוק|שמות|טו|ה}}<קטע סוף=סימן/><קטע התחלה=ה/>תְּהֹמֹ֖ת יְכַסְיֻ֑מוּ יָרְד֥וּ בִמְצוֹלֹ֖ת כְּמוֹ־אָֽבֶן׃<קטע סוף=ה/>
{{מ:ששש}}<קטע התחלה=סימן/>{{מ:פסוק|שמות|טו|ו}}<קטע סוף=סימן/><קטע התחלה=ו/>יְמִֽינְךָ֣ יְהֹוָ֔ה נֶאְדָּרִ֖י בַּכֹּ֑חַ{{מ:ששש}}יְמִֽינְךָ֥ יְהֹוָ֖ה תִּרְעַ֥ץ אוֹיֵֽב׃<קטע סוף=ו/>
{{מ:ששש}}<קטע התחלה=סימן/>{{מ:פסוק|שמות|טו|ז}}<קטע סוף=סימן/><קטע התחלה=ז/>וּבְרֹ֥ב גְּאוֹנְךָ֖ תַּהֲרֹ֣ס קָמֶ֑יךָ{{מ:ששש}}תְּשַׁלַּח֙ חֲרֹ֣נְךָ֔ יֹאכְלֵ֖מוֹ כַּקַּֽשׁ׃<קטע סוף=ז/>
{{מ:ששש}}<קטע התחלה=סימן/>{{מ:פסוק|שמות|טו|ח}}<קטע סוף=סימן/><קטע התחלה=ח/>וּבְר֤וּחַ אַפֶּ֙יךָ֙ נֶ֣עֶרְמוּ מַ֔יִם{{מ:ששש}}נִצְּב֥וּ כְמוֹ־נֵ֖ד נֹזְלִ֑ים{{מ:ששש}}קָֽפְא֥וּ תְהֹמֹ֖ת בְּלֶב־יָֽם׃<קטע סוף=ח/>
{{מ:ששש}}<קטע התחלה=סימן/>{{מ:פסוק|שמות|טו|ט}}<קטע סוף=סימן/><קטע התחלה=ט/>אָמַ֥ר אוֹיֵ֛ב אֶרְדֹּ֥ף אַשִּׂ֖יג{{מ:ששש}}אֲחַלֵּ֣ק שָׁלָ֑ל תִּמְלָאֵ֣מוֹ נַפְשִׁ֔י{{מ:ששש}}אָרִ֣יק חַרְבִּ֔י תּוֹרִישֵׁ֖מוֹ יָדִֽי׃<קטע סוף=ט/>
{{מ:ששש}}<קטע התחלה=סימן/>{{מ:פסוק|שמות|טו|י}}<קטע סוף=סימן/><קטע התחלה=י/>נָשַׁ֥פְתָּ בְרוּחֲךָ֖ כִּסָּ֣מוֹ יָ֑ם{{מ:ששש}}{{נוסח|צָֽלְﬞלוּ֙|2==ש,ש1,ו ומ"ש ("הלמ"ד בשווא לבד כמנהגנו"){{ש}}ל,ל1,ב,ק3=צָֽלֲלוּ֙ (חטף){{ש}}הערת ברויאר}} כַּֽעוֹפֶ֔רֶת בְּמַ֖יִם אַדִּירִֽים׃<קטע סוף=י/>
{{מ:ששש}}<קטע התחלה=סימן/>{{מ:פסוק|שמות|טו|יא}}<קטע סוף=סימן/><קטע התחלה=יא/>מִֽי־כָמֹ֤כָה בָּֽאֵלִם֙ יְהֹוָ֔ה{{מ:ששש}}מִ֥י כָּמֹ֖כָה נֶאְדָּ֣ר בַּקֹּ֑דֶשׁ{{מ:ששש}}נוֹרָ֥א תְהִלֹּ֖ת עֹ֥שֵׂה פֶֽלֶא׃<קטע סוף=יא/>
{{מ:ששש}}<קטע התחלה=סימן/>{{מ:פסוק|שמות|טו|יב}}<קטע סוף=סימן/><קטע התחלה=יב/>נָטִ֙יתָ֙ יְמִ֣ינְךָ֔ תִּבְלָעֵ֖מוֹ אָֽרֶץ׃<קטע סוף=יב/>
{{מ:ששש}}<קטע התחלה=סימן/>{{מ:פסוק|שמות|טו|יג}}<קטע סוף=סימן/><קטע התחלה=יג/>נָחִ֥יתָ בְחַסְדְּךָ֖ עַם־ז֣וּ גָּאָ֑לְתָּ{{מ:ששש}}נֵהַ֥לְתָּ בְעׇזְּךָ֖ אֶל־נְוֵ֥ה קׇדְשֶֽׁךָ׃<קטע סוף=יג/>
{{מ:ששש}}<קטע התחלה=סימן/>{{מ:פסוק|שמות|טו|יד}}<קטע סוף=סימן/><קטע התחלה=יד/>שָֽׁמְע֥וּ עַמִּ֖ים יִרְגָּז֑וּן{{מ:ששש}}חִ֣יל אָחַ֔ז יֹשְׁבֵ֖י פְּלָֽשֶׁת׃<קטע סוף=יד/>
{{מ:ששש}}<קטע התחלה=סימן/>{{מ:פסוק|שמות|טו|טו}}<קטע סוף=סימן/><קטע התחלה=טו/>אָ֤ז נִבְהֲלוּ֙ אַלּוּפֵ֣י אֱד֔וֹם{{מ:ששש}}אֵילֵ֣י מוֹאָ֔ב יֹֽאחֲזֵ֖מוֹ רָ֑עַד{{מ:ששש}}נָמֹ֕גוּ כֹּ֖ל יֹשְׁבֵ֥י כְנָֽעַן׃<קטע סוף=טו/>
{{מ:ששש}}<קטע התחלה=סימן/>{{מ:פסוק|שמות|טו|טז}}<קטע סוף=סימן/><קטע התחלה=טז/>תִּפֹּ֨ל עֲלֵיהֶ֤ם אֵימָ֙תָה֙ וָפַ֔חַד{{מ:ששש}}בִּגְדֹ֥ל זְרוֹעֲךָ֖ יִדְּמ֣וּ כָּאָ֑בֶן{{מ:ששש}}עַד־יַעֲבֹ֤ר עַמְּךָ֙ יְהֹוָ֔ה{{מ:ששש}}עַֽד־יַעֲבֹ֖ר עַם־ז֥וּ קָנִֽיתָ׃<קטע סוף=טז/>
{{מ:ששש}}<קטע התחלה=סימן/>{{מ:פסוק|שמות|טו|יז}}<קטע סוף=סימן/><קטע התחלה=יז/>תְּבִאֵ֗מוֹ וְתִטָּעֵ֙מוֹ֙ בְּהַ֣ר נַחֲלָֽתְךָ֔{{מ:ששש}}מָכ֧וֹן לְשִׁבְתְּךָ֛ פָּעַ֖לְתָּ יְהֹוָ֑ה{{מ:ששש}}מִקְּדָ֕שׁ אֲדֹנָ֖י כּוֹנְנ֥וּ יָדֶֽיךָ׃<קטע סוף=יז/>
{{מ:ששש}}<קטע התחלה=סימן/>{{מ:פסוק|שמות|טו|יח}}<קטע סוף=סימן/><קטע התחלה=יח/>יְהֹוָ֥ה{{מ:פסק}}יִמְלֹ֖ךְ לְעֹלָ֥ם וָעֶֽד׃<קטע סוף=יח/>
{{מ:ששש}}<קטע התחלה=סימן/>{{מ:פסוק|שמות|טו|יט}}<קטע סוף=סימן/><קטע התחלה=יט/>כִּ֣י בָא֩ ס֨וּס פַּרְעֹ֜ה בְּרִכְבּ֤וֹ וּבְפָרָשָׁיו֙ בַּיָּ֔ם{{מ:ששש}}וַיָּ֧שֶׁב יְהֹוָ֛ה עֲלֵהֶ֖ם אֶת־מֵ֣י הַיָּ֑ם{{מ:ששש}}וּבְנֵ֧י יִשְׂרָאֵ֛ל הָלְכ֥וּ בַיַּבָּשָׁ֖ה בְּת֥וֹךְ הַיָּֽם׃<קטע סוף=יט/>
{{פפ}}
<קטע התחלה=סימן/>{{מ:פסוק|שמות|טו|כ}}<קטע סוף=סימן/><קטע התחלה=כ/>וַתִּקַּח֩ מִרְיָ֨ם הַנְּבִיאָ֜ה אֲח֧וֹת אַהֲרֹ֛ן אֶת־הַתֹּ֖ף בְּיָדָ֑הּ וַתֵּצֶ֤אןָ כׇֽל־הַנָּשִׁים֙ אַחֲרֶ֔יהָ בְּתֻפִּ֖ים וּבִמְחֹלֹֽת׃<קטע סוף=כ/>
<קטע התחלה=סימן/>{{מ:פסוק|שמות|טו|כא}}<קטע סוף=סימן/><קטע התחלה=כא/>וַתַּ֥עַן לָהֶ֖ם מִרְיָ֑ם שִׁ֤ירוּ לַֽיהֹוָה֙ כִּֽי־גָאֹ֣ה גָּאָ֔ה ס֥וּס וְרֹכְב֖וֹ רָמָ֥ה בַיָּֽם׃<קטע סוף=כא/>
{{סס}}<קטע התחלה=סימן/>{{מ:פסוק|שמות|טו|כב}}<קטע סוף=סימן/><קטע התחלה=כב/>וַיַּסַּ֨ע מֹשֶׁ֤ה אֶת־יִשְׂרָאֵל֙ מִיַּם־ס֔וּף וַיֵּצְא֖וּ אֶל־מִדְבַּר־שׁ֑וּר וַיֵּלְכ֧וּ שְׁלֹֽשֶׁת־יָמִ֛ים בַּמִּדְבָּ֖ר וְלֹא־מָ֥צְאוּ מָֽיִם׃<קטע סוף=כב/>
<קטע התחלה=סימן/>{{מ:פסוק|שמות|טו|כג}}<קטע סוף=סימן/><קטע התחלה=כג/>וַיָּבֹ֣אוּ מָרָ֔תָה וְלֹ֣א יָֽכְל֗וּ לִשְׁתֹּ֥ת מַ֙יִם֙ מִמָּרָ֔ה כִּ֥י מָרִ֖ים הֵ֑ם עַל־כֵּ֥ן {{נוסח|קָרָֽא־שְׁמָ֖הּ|2==א(ס),ל,ל1,ש1 (געיה ברי"ש){{ש}}ש,ק3,ו=<קָֽרָא־שְׁמָ֖הּ> (געיה [ימנית] לעיל באות קו"ף); וכמו כן בחלק מהדפוסים וקורן.{{ש}}ב!=קְרָא־שְׁמָ֖הּ (אות קו"ף שווּאה)}} מָרָֽה׃<קטע סוף=כג/>
<קטע התחלה=סימן/>{{מ:פסוק|שמות|טו|כד}}<קטע סוף=סימן/><קטע התחלה=כד/>וַיִּלֹּ֧נוּ הָעָ֛ם עַל־מֹשֶׁ֥ה לֵּאמֹ֖ר מַה־נִּשְׁתֶּֽה׃<קטע סוף=כד/>
<קטע התחלה=סימן/>{{מ:פסוק|שמות|טו|כה}}<קטע סוף=סימן/><קטע התחלה=כה/>וַיִּצְעַ֣ק אֶל־יְהֹוָ֗ה וַיּוֹרֵ֤הוּ יְהֹוָה֙ עֵ֔ץ וַיַּשְׁלֵךְ֙ אֶל־הַמַּ֔יִם וַֽיִּמְתְּק֖וּ הַמָּ֑יִם שָׁ֣ם שָׂ֥ם ל֛וֹ חֹ֥ק וּמִשְׁפָּ֖ט וְשָׁ֥ם נִסָּֽהוּ׃<קטע סוף=כה/>
<קטע התחלה=סימן/>{{מ:פסוק|שמות|טו|כו}}<קטע סוף=סימן/><קטע התחלה=כו/>וַיֹּ֩אמֶר֩ אִם־שָׁמ֨וֹעַ תִּשְׁמַ֜ע לְק֣וֹל{{מ:לגרמיה-2}} יְהֹוָ֣ה אֱלֹהֶ֗יךָ וְהַיָּשָׁ֤ר בְּעֵינָיו֙ תַּעֲשֶׂ֔ה וְהַֽאֲזַנְתָּ֙ לְמִצְוֺתָ֔יו וְשָׁמַרְתָּ֖ כׇּל־חֻקָּ֑יו {{נוסח|כׇּֽל־הַמַּחֲלָ֞ה|2==ל-מ,ל1?,ב,ש,ש1,ק3,ו (געיה אחת באות כ"ף); ראו רשימת ברויאר ב"ספיקות שאין להם הכרע", הערה 8 ובספר טעמי המקרא פרק ח (וכך אצל ברויאר).{{ש}}ל!,ל1?=<כָּֽל־הַמַּֽחֲלָ֞ה> בשתי געיות בתיבות המוקפות (געיה ימנית באות מ"ם בכתי"ל, וגעיה ספק מחוקה בכתי"ל1).{{ש}}מג"ה=כָּל־הַֽמַּחֲלָ֞ה{{ש}}קורן=כָּל־הַֽמַּֽחֲלָ֞ה}} אֲשֶׁר־שַׂ֤מְתִּי בְמִצְרַ֙יִם֙ לֹא־אָשִׂ֣ים עָלֶ֔יךָ כִּ֛י אֲנִ֥י יְהֹוָ֖ה רֹפְאֶֽךָ׃<קטע סוף=כו/>
{{סס}}<קטע התחלה=סימן/>{{מ:פסוק|שמות|טו|כז|עלייה={{מ:עלייה|א=חמישי|ב0=בשלח|ב1=חמישי}}}}<קטע סוף=סימן/><קטע התחלה=כז/>וַיָּבֹ֣אוּ אֵילִ֔מָה וְשָׁ֗ם שְׁתֵּ֥ים עֶשְׂרֵ֛ה עֵינֹ֥ת מַ֖יִם וְשִׁבְעִ֣ים תְּמָרִ֑ים וַיַּחֲנוּ־שָׁ֖ם עַל־הַמָּֽיִם׃<קטע סוף=כז/><קטע סוף=פרק טו/><noinclude>
