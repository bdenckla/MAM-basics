==שירת אסף בצורות כתיבה נוספות==
{{תצוגת כתי"א|תחילת שירת אסף בצורת שיר|File:Aleppo-fascimile3-Ketuvim.pdf|19}}
{{תצוגת כתי"ל|תחילת שירת אסף בצורת שיר|File:Leningrad-codex-14-chronicles.pdf|20}}
נספח זה מציג את שירת אסף במבחר צורות כתיבה שימושיות. לצורת השיר (לפי כתר ארם צובה) ראו ברצף הפסוקים ב'''[[ספר דברי הימים/טעמים#שירת אסף חזרה|ספר דברי הימים]]''' וב'''[[דברי הימים א טז/טעמים#שירת אסף חזרה|דה"א פרק ט"ז]]'''.

===שירת אסף בכתיבה רגילה===

<קטע התחלה=כתיבה רגילה/>{{תבנית:משתמש:Dovi/טעמי המקרא}}
הוֹד֤וּ לַֽיהֹוָה֙ קִרְא֣וּ בִשְׁמ֔וֹ הוֹדִ֥יעוּ בָעַמִּ֖ים עֲלִילֹתָֽיו׃ שִׁ֤ירוּ לוֹ֙ זַמְּרוּ־ל֔וֹ שִׂ֖יחוּ בְּכׇל־נִפְלְאֹתָֽיו׃ הִֽתְהַלְלוּ֙ בְּשֵׁ֣ם קׇדְשׁ֔וֹ יִשְׂמַ֕ח לֵ֖ב מְבַקְשֵׁ֥י יְהֹוָֽה׃ דִּרְשׁ֤וּ יְהֹוָה֙ וְעֻזּ֔וֹ בַּקְּשׁ֥וּ פָנָ֖יו תָּמִֽיד׃ זִכְר֗וּ נִפְלְאֹתָיו֙ אֲשֶׁ֣ר עָשָׂ֔ה מֹפְתָ֖יו וּמִשְׁפְּטֵי־פִֽיהוּ׃ זֶ֚רַע יִשְׂרָאֵ֣ל עַבְדּ֔וֹ בְּנֵ֥י יַעֲקֹ֖ב בְּחִירָֽיו׃ ה֚וּא יְהֹוָ֣ה אֱלֹהֵ֔ינוּ בְּכׇל־הָאָ֖רֶץ מִשְׁפָּטָֽיו׃ זִכְר֤וּ לְעוֹלָם֙ בְּרִית֔וֹ דָּבָ֥ר צִוָּ֖ה לְאֶ֥לֶף דּֽוֹר׃ אֲשֶׁ֤ר כָּרַת֙ אֶת־אַבְרָהָ֔ם וּשְׁבוּעָת֖וֹ לְיִצְחָֽק׃ וַיַּעֲמִידֶ֤הָ לְיַֽעֲקֹב֙ לְחֹ֔ק לְיִשְׂרָאֵ֖ל בְּרִ֥ית עוֹלָֽם׃ לֵאמֹ֗ר לְךָ֙ אֶתֵּ֣ן אֶֽרֶץ־כְּנָ֔עַן חֶ֖בֶל נַחֲלַתְכֶֽם׃ בִּהְיֽוֹתְכֶם֙ מְתֵ֣י מִסְפָּ֔ר כִּמְעַ֖ט וְגָרִ֥ים בָּֽהּ׃ וַיִּֽתְהַלְּכוּ֙ מִגּ֣וֹי אֶל־גּ֔וֹי וּמִמַּמְלָכָ֖ה אֶל־עַ֥ם אַחֵֽר׃ לֹֽא־הִנִּ֤יחַ לְאִישׁ֙ לְעׇשְׁקָ֔ם וַיּ֥וֹכַח עֲלֵיהֶ֖ם מְלָכִֽים׃ אַֽל־תִּגְּעוּ֙ בִּמְשִׁיחָ֔י וּבִנְבִיאַ֖י אַל־תָּרֵֽעוּ׃
{{פפ}}
שִׁ֤ירוּ לַֽיהֹוָה֙ כׇּל־הָאָ֔רֶץ בַּשְּׂר֥וּ מִיּֽוֹם־אֶל־י֖וֹם יְשׁוּעָתֽוֹ׃ סַפְּר֤וּ בַגּוֹיִם֙ אֶת־כְּבוֹד֔וֹ בְּכׇל־הָעַמִּ֖ים נִפְלְאֹתָֽיו׃ כִּי֩ גָד֨וֹל יְהֹוָ֤ה וּמְהֻלָּל֙ מְאֹ֔ד וְנוֹרָ֥א ה֖וּא עַל־כׇּל־אֱלֹהִֽים׃ כִּ֠י כׇּל־אֱלֹהֵ֤י הָֽעַמִּים֙ אֱלִילִ֔ים וַיהֹוָ֖ה שָׁמַ֥יִם עָשָֽׂה׃ ה֤וֹד וְהָדָר֙ לְפָנָ֔יו עֹ֥ז וְחֶדְוָ֖ה בִּמְקֹמֽוֹ׃ הָב֤וּ לַֽיהֹוָה֙ מִשְׁפְּח֣וֹת עַמִּ֔ים הָב֥וּ לַיהֹוָ֖ה כָּב֥וֹד וָעֹֽז׃ הָב֥וּ לַֽיהֹוָ֖ה כְּב֣וֹד שְׁמ֑וֹ שְׂא֤וּ מִנְחָה֙ וּבֹ֣אוּ לְפָנָ֔יו הִשְׁתַּחֲו֥וּ לַֽיהֹוָ֖ה בְּהַדְרַת־קֹֽדֶשׁ׃ חִ֤ילוּ מִלְּפָנָיו֙ כׇּל־הָאָ֔רֶץ אַף־תִּכּ֥וֹן תֵּבֵ֖ל בַּל־תִּמּֽוֹט׃ יִשְׂמְח֤וּ הַשָּׁמַ֙יִם֙ וְתָגֵ֣ל הָאָ֔רֶץ וְיֹאמְר֥וּ בַגּוֹיִ֖ם יְהֹוָ֥ה מָלָֽךְ׃ יִרְעַ֤ם הַיָּם֙ וּמְלוֹא֔וֹ יַעֲלֹ֥ץ הַשָּׂדֶ֖ה וְכׇל־אֲשֶׁר־בּֽוֹ׃ אָ֥ז יְרַנְּנ֖וּ עֲצֵ֣י הַיָּ֑עַר מִלִּפְנֵ֣י יְהֹוָ֔ה כִּי־בָ֖א לִשְׁפּ֥וֹט אֶת־הָאָֽרֶץ׃ הוֹד֤וּ לַֽיהֹוָה֙ כִּ֣י ט֔וֹב כִּ֥י לְעוֹלָ֖ם חַסְדּֽוֹ׃ וְאִמְר֕וּ הוֹשִׁיעֵ֙נוּ֙ אֱלֹהֵ֣י יִשְׁעֵ֔נוּ וְקַבְּצֵ֥נוּ וְהַצִּילֵ֖נוּ מִן־הַגּוֹיִ֑ם לְהֹדוֹת֙ לְשֵׁ֣ם קׇדְשֶׁ֔ךָ לְהִשְׁתַּבֵּ֖חַ בִּתְהִלָּתֶֽךָ׃ בָּר֤וּךְ יְהֹוָה֙ אֱלֹהֵ֣י יִשְׂרָאֵ֔ל מִן־הָעוֹלָ֖ם וְעַ֣ד הָעֹלָ֑ם וַיֹּאמְר֤וּ כׇל־הָעָם֙ אָמֵ֔ן וְהַלֵּ֖ל לַיהֹוָֽה׃
{{תבנית:משתמש:Dovi/טעמי המקרא-סוף}}<קטע סוף=כתיבה רגילה/>

===חלוקה לשורות לפי פסוק===

<קטע התחלה=חלוקה לשורות/>{{תבנית:משתמש:Dovi/טעמי המקרא}}
הוֹד֤וּ לַֽיהֹוָה֙ קִרְא֣וּ בִשְׁמ֔וֹ הוֹדִ֥יעוּ בָעַמִּ֖ים עֲלִילֹתָֽיו׃{{ר4}}שִׁ֤ירוּ לוֹ֙ זַמְּרוּ־ל֔וֹ שִׂ֖יחוּ בְּכׇל־נִפְלְאֹתָֽיו׃{{ר4}}הִֽתְהַלְלוּ֙ בְּשֵׁ֣ם קׇדְשׁ֔וֹ יִשְׂמַ֕ח לֵ֖ב מְבַקְשֵׁ֥י יְהֹוָֽה׃{{ר4}}דִּרְשׁ֤וּ יְהֹוָה֙ וְעֻזּ֔וֹ בַּקְּשׁ֥וּ פָנָ֖יו תָּמִֽיד׃{{ר4}}זִכְר֗וּ נִפְלְאֹתָיו֙ אֲשֶׁ֣ר עָשָׂ֔ה מֹפְתָ֖יו וּמִשְׁפְּטֵי־פִֽיהוּ׃{{ר4}}זֶ֚רַע יִשְׂרָאֵ֣ל עַבְדּ֔וֹ בְּנֵ֥י יַעֲקֹ֖ב בְּחִירָֽיו׃{{ר4}}ה֚וּא יְהֹוָ֣ה אֱלֹהֵ֔ינוּ בְּכׇל־הָאָ֖רֶץ מִשְׁפָּטָֽיו׃{{ר4}}זִכְר֤וּ לְעוֹלָם֙ בְּרִית֔וֹ דָּבָ֥ר צִוָּ֖ה לְאֶ֥לֶף דּֽוֹר׃{{ר4}}אֲשֶׁ֤ר כָּרַת֙ אֶת־אַבְרָהָ֔ם וּשְׁבוּעָת֖וֹ לְיִצְחָֽק׃{{ר4}}וַיַּעֲמִידֶ֤הָ לְיַֽעֲקֹב֙ לְחֹ֔ק לְיִשְׂרָאֵ֖ל בְּרִ֥ית עוֹלָֽם׃{{ר4}}לֵאמֹ֗ר לְךָ֙ אֶתֵּ֣ן אֶֽרֶץ־כְּנָ֔עַן חֶ֖בֶל נַחֲלַתְכֶֽם׃{{ר4}}בִּהְיֽוֹתְכֶם֙ מְתֵ֣י מִסְפָּ֔ר כִּמְעַ֖ט וְגָרִ֥ים בָּֽהּ׃{{ר4}}וַיִּֽתְהַלְּכוּ֙ מִגּ֣וֹי אֶל־גּ֔וֹי וּמִמַּמְלָכָ֖ה אֶל־עַ֥ם אַחֵֽר׃{{ר4}}לֹֽא־הִנִּ֤יחַ לְאִישׁ֙ לְעׇשְׁקָ֔ם וַיּ֥וֹכַח עֲלֵיהֶ֖ם מְלָכִֽים׃{{ר4}}אַֽל־תִּגְּעוּ֙ בִּמְשִׁיחָ֔י וּבִנְבִיאַ֖י אַל־תָּרֵֽעוּ׃
{{פפ}}
שִׁ֤ירוּ לַֽיהֹוָה֙ כׇּל־הָאָ֔רֶץ בַּשְּׂר֥וּ מִיּֽוֹם־אֶל־י֖וֹם יְשׁוּעָתֽוֹ׃{{ר4}}סַפְּר֤וּ בַגּוֹיִם֙ אֶת־כְּבוֹד֔וֹ בְּכׇל־הָעַמִּ֖ים נִפְלְאֹתָֽיו׃{{ר4}}כִּי֩ גָד֨וֹל יְהֹוָ֤ה וּמְהֻלָּל֙ מְאֹ֔ד וְנוֹרָ֥א ה֖וּא עַל־כׇּל־אֱלֹהִֽים׃{{ר4}}כִּ֠י כׇּל־אֱלֹהֵ֤י הָֽעַמִּים֙ אֱלִילִ֔ים וַיהֹוָ֖ה שָׁמַ֥יִם עָשָֽׂה׃{{ר4}}ה֤וֹד וְהָדָר֙ לְפָנָ֔יו עֹ֥ז וְחֶדְוָ֖ה בִּמְקֹמֽוֹ׃{{ר4}}הָב֤וּ לַֽיהֹוָה֙ מִשְׁפְּח֣וֹת עַמִּ֔ים הָב֥וּ לַיהֹוָ֖ה כָּב֥וֹד וָעֹֽז׃{{ר4}}הָב֥וּ לַֽיהֹוָ֖ה כְּב֣וֹד שְׁמ֑וֹ שְׂא֤וּ מִנְחָה֙ וּבֹ֣אוּ לְפָנָ֔יו הִשְׁתַּחֲו֥וּ לַֽיהֹוָ֖ה בְּהַדְרַת־קֹֽדֶשׁ׃{{ר4}}חִ֤ילוּ מִלְּפָנָיו֙ כׇּל־הָאָ֔רֶץ אַף־תִּכּ֥וֹן תֵּבֵ֖ל בַּל־תִּמּֽוֹט׃{{ר4}}יִשְׂמְח֤וּ הַשָּׁמַ֙יִם֙ וְתָגֵ֣ל הָאָ֔רֶץ וְיֹאמְר֥וּ בַגּוֹיִ֖ם יְהֹוָ֥ה מָלָֽךְ׃{{ר4}}יִרְעַ֤ם הַיָּם֙ וּמְלוֹא֔וֹ יַעֲלֹ֥ץ הַשָּׂדֶ֖ה וְכׇל־אֲשֶׁר־בּֽוֹ׃{{ר4}}אָ֥ז יְרַנְּנ֖וּ עֲצֵ֣י הַיָּ֑עַר מִלִּפְנֵ֣י יְהֹוָ֔ה כִּי־בָ֖א לִשְׁפּ֥וֹט אֶת־הָאָֽרֶץ׃{{ר4}}הוֹד֤וּ לַֽיהֹוָה֙ כִּ֣י ט֔וֹב כִּ֥י לְעוֹלָ֖ם חַסְדּֽוֹ׃{{ר4}}וְאִמְר֕וּ הוֹשִׁיעֵ֙נוּ֙ אֱלֹהֵ֣י יִשְׁעֵ֔נוּ וְקַבְּצֵ֥נוּ וְהַצִּילֵ֖נוּ מִן־הַגּוֹיִ֑ם לְהֹדוֹת֙ לְשֵׁ֣ם קׇדְשֶׁ֔ךָ לְהִשְׁתַּבֵּ֖חַ בִּתְהִלָּתֶֽךָ׃{{ר4}}בָּר֤וּךְ יְהֹוָה֙ אֱלֹהֵ֣י יִשְׂרָאֵ֔ל מִן־הָעוֹלָ֖ם וְעַ֣ד הָעֹלָ֑ם וַיֹּאמְר֤וּ כׇל־הָעָם֙ אָמֵ֔ן וְהַלֵּ֖ל לַיהֹוָֽה׃
{{תבנית:משתמש:Dovi/טעמי המקרא-סוף}}<קטע סוף=חלוקה לשורות/>

===שירת אסף בכתיבה שירית===

<קטע התחלה=כתיבה שירית/>{{תבנית:משתמש:Dovi/טעמי המקרא}}
הוֹד֤וּ לַֽיהֹוָה֙ קִרְא֣וּ בִשְׁמ֔וֹ{{ר1}}הוֹדִ֥יעוּ בָעַמִּ֖ים עֲלִילֹתָֽיו׃{{ר4}}שִׁ֤ירוּ לוֹ֙ זַמְּרוּ־ל֔וֹ{{ר1}}שִׂ֖יחוּ בְּכׇל־נִפְלְאֹתָֽיו׃{{ר4}}הִֽתְהַלְלוּ֙ בְּשֵׁ֣ם קׇדְשׁ֔וֹ{{ר1}}יִשְׂמַ֕ח לֵ֖ב מְבַקְשֵׁ֥י יְהֹוָֽה׃{{ר4}}דִּרְשׁ֤וּ יְהֹוָה֙ וְעֻזּ֔וֹ{{ר1}}בַּקְּשׁ֥וּ פָנָ֖יו תָּמִֽיד׃{{ר4}}זִכְר֗וּ נִפְלְאֹתָיו֙ אֲשֶׁ֣ר עָשָׂ֔ה{{ר1}}מֹפְתָ֖יו וּמִשְׁפְּטֵי־פִֽיהוּ׃{{ר4}}זֶ֚רַע יִשְׂרָאֵ֣ל עַבְדּ֔וֹ{{ר1}}בְּנֵ֥י יַעֲקֹ֖ב בְּחִירָֽיו׃{{ר4}}ה֚וּא יְהֹוָ֣ה אֱלֹהֵ֔ינוּ{{ר1}}בְּכׇל־הָאָ֖רֶץ מִשְׁפָּטָֽיו׃{{ר4}}זִכְר֤וּ לְעוֹלָם֙ בְּרִית֔וֹ{{ר1}}דָּבָ֥ר צִוָּ֖ה לְאֶ֥לֶף דּֽוֹר׃{{ר4}}אֲשֶׁ֤ר כָּרַת֙ אֶת־אַבְרָהָ֔ם{{ר1}}וּשְׁבוּעָת֖וֹ לְיִצְחָֽק׃{{ר4}}וַיַּעֲמִידֶ֤הָ לְיַֽעֲקֹב֙ לְחֹ֔ק{{ר1}}לְיִשְׂרָאֵ֖ל בְּרִ֥ית עוֹלָֽם׃{{ר4}}לֵאמֹ֗ר לְךָ֙ אֶתֵּ֣ן אֶֽרֶץ־כְּנָ֔עַן{{ר1}}חֶ֖בֶל נַחֲלַתְכֶֽם׃{{ר4}}בִּהְיֽוֹתְכֶם֙ מְתֵ֣י מִסְפָּ֔ר{{ר1}}כִּמְעַ֖ט וְגָרִ֥ים בָּֽהּ׃{{ר4}}וַיִּֽתְהַלְּכוּ֙ מִגּ֣וֹי אֶל־גּ֔וֹי{{ר1}}וּמִמַּמְלָכָ֖ה אֶל־עַ֥ם אַחֵֽר׃{{ר4}}לֹֽא־הִנִּ֤יחַ לְאִישׁ֙ לְעׇשְׁקָ֔ם{{ר1}}וַיּ֥וֹכַח עֲלֵיהֶ֖ם מְלָכִֽים׃{{ר4}}אַֽל־תִּגְּעוּ֙ בִּמְשִׁיחָ֔י{{ר1}}וּבִנְבִיאַ֖י אַל־תָּרֵֽעוּ׃
{{פפ}}
שִׁ֤ירוּ לַֽיהֹוָה֙ כׇּל־הָאָ֔רֶץ{{ר1}}בַּשְּׂר֥וּ מִיּֽוֹם־אֶל־י֖וֹם יְשׁוּעָתֽוֹ׃{{ר4}}סַפְּר֤וּ בַגּוֹיִם֙ אֶת־כְּבוֹד֔וֹ{{ר1}}בְּכׇל־הָעַמִּ֖ים נִפְלְאֹתָֽיו׃{{ר4}}כִּי֩ גָד֨וֹל יְהֹוָ֤ה וּמְהֻלָּל֙ מְאֹ֔ד{{ר1}}וְנוֹרָ֥א ה֖וּא עַל־כׇּל־אֱלֹהִֽים׃{{ר4}}כִּ֠י כׇּל־אֱלֹהֵ֤י הָֽעַמִּים֙ אֱלִילִ֔ים{{ר1}}וַיהֹוָ֖ה שָׁמַ֥יִם עָשָֽׂה׃{{ר4}}ה֤וֹד וְהָדָר֙ לְפָנָ֔יו{{ר1}}עֹ֥ז וְחֶדְוָ֖ה בִּמְקֹמֽוֹ׃{{ר4}}הָב֤וּ לַֽיהֹוָה֙ מִשְׁפְּח֣וֹת עַמִּ֔ים{{ר1}}הָב֥וּ לַיהֹוָ֖ה כָּב֥וֹד וָעֹֽז׃{{ר4}}הָב֥וּ לַֽיהֹוָ֖ה כְּב֣וֹד שְׁמ֑וֹ{{ר1}}שְׂא֤וּ מִנְחָה֙ וּבֹ֣אוּ לְפָנָ֔יו{{ר2}}הִשְׁתַּחֲו֥וּ לַֽיהֹוָ֖ה בְּהַדְרַת־קֹֽדֶשׁ׃{{ר4}}חִ֤ילוּ מִלְּפָנָיו֙ כׇּל־הָאָ֔רֶץ{{ר1}}אַף־תִּכּ֥וֹן תֵּבֵ֖ל בַּל־תִּמּֽוֹט׃{{ר4}}יִשְׂמְח֤וּ הַשָּׁמַ֙יִם֙ וְתָגֵ֣ל הָאָ֔רֶץ{{ר1}}וְיֹאמְר֥וּ בַגּוֹיִ֖ם יְהֹוָ֥ה מָלָֽךְ׃{{ר4}}יִרְעַ֤ם הַיָּם֙ וּמְלוֹא֔וֹ{{ר1}}יַעֲלֹ֥ץ הַשָּׂדֶ֖ה וְכׇל־אֲשֶׁר־בּֽוֹ׃{{ר4}}אָ֥ז יְרַנְּנ֖וּ עֲצֵ֣י הַיָּ֑עַר{{ר1}}מִלִּפְנֵ֣י יְהֹוָ֔ה{{ר1}}כִּי־בָ֖א לִשְׁפּ֥וֹט אֶת־הָאָֽרֶץ׃{{ר4}}הוֹד֤וּ לַֽיהֹוָה֙ כִּ֣י ט֔וֹב{{ר1}}כִּ֥י לְעוֹלָ֖ם חַסְדּֽוֹ׃{{ר4}}וְאִמְר֕וּ הוֹשִׁיעֵ֙נוּ֙ אֱלֹהֵ֣י יִשְׁעֵ֔נוּ{{ר1}}וְקַבְּצֵ֥נוּ וְהַצִּילֵ֖נוּ מִן־הַגּוֹיִ֑ם{{ר4}}לְהֹדוֹת֙ לְשֵׁ֣ם קׇדְשֶׁ֔ךָ{{ר1}}לְהִשְׁתַּבֵּ֖חַ בִּתְהִלָּתֶֽךָ׃{{ר4}}בָּר֤וּךְ יְהֹוָה֙ אֱלֹהֵ֣י יִשְׂרָאֵ֔ל{{ר1}}מִן־הָעוֹלָ֖ם וְעַ֣ד הָעֹלָ֑ם{{ר2}}וַיֹּאמְר֤וּ כׇל־הָעָם֙ אָמֵ֔ן{{ר2}}וְהַלֵּ֖ל לַיהֹוָֽה׃
