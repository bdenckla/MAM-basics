{
  "type": "cant-bet",
  "contents": [
    {
      "type": "text",
      "text": "לֹ֣א תַעֲשֶֽׂה־לְךָ֣ פֶ֣סֶל"
    },
    {
      "type": "lp-paseq"
    },
    {
      "type": "text",
      "text": "וְכׇל־תְּמוּנָ֡ה אֲשֶׁ֣ר בַּשָּׁמַ֣יִם"
    },
    {
      "type": "lp-paseq"
    },
    {
      "type": "text",
      "text": "מִמַּ֡עַל וַֽאֲשֶׁר֩ בָּאָ֨רֶץ מִתַּ֜חַת וַאֲשֶׁ֥ר בַּמַּ֣יִם"
    },
    {
      "type": "lp-legarmeih"
    },
    {
      "type": "text",
      "text": " מִתַּ֣חַת לָאָ֗רֶץ"
    }
  ]
}
