{
  "Isaiah.11.13.7-t.html": "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01//EN\" \"http://www.w3.org/TR/html4/strict.dtd\"><HTML>\n<!-- \n     Computer generated from NoteMaker[20 Jan 2026]: \n     Changes file: 2023.04.01 - Changes.xml, date: 2022.12.09, number: 2 .\n     Remove this token \"****COMPUTER-GENERATED****\" if you edit this file manually.\n-->\n<head><meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\"/>\n  <title>Isaiah 11:13.7</title>\n</head>\n<body background=\"../../Images/Background\">\n  <h1>Isaiah 11:13.7</h1>\n  <h2>Possible sheva on yod. Add note 't'</h2>\n  <table align=\"center\"  cellpadding=\"5pt\">\n    <tr>\n      <td>\n        <center>\n          <img src=\"../../Changes/2023.04.01 - Changes/images/2022.12.09/2-Detail.jpg\"  border=\"4pt\">\n          </img>\n        </center>\n      </td>\n    </tr>\n    <tr>\n      <td>\n        <center>Credit: Sefaria.org.</center>\n      </td>\n    </tr>\n  </table>\n  <p>\n                    The putative upper sheva dot on the yod is well-sized, reddish and positioned to the right of the lower dot.\n                </p>\n  <p>\n                    BHL has hireq on the yod. \n                    BHL Appendix A has a sheva on the yod.\n                </p>\n  <p>\n    <b>\n      <i>Daniel Holman</i>\n    </b>\n  </p>\n  <p align=\"right\">\n    <b><a target=\"_blank\" href=\"../../Changes/2023.04.01 - Changes/2023.04.01 - Changes.xml?2022.12.09-2\">2023.04.01 - Changes.xml : 2022.12.09-2</a>\n    </b>\n  </p>\n  <table align=\"center\"  cellpadding=\"20pt\"  border=\"1pt\">\n    <tr>\n      <td>\n        <p>\n          <center><a target=\"_blank\" href=\"../../Supplements/Notes.xml?t\">All \"Transcription uncertain\" ('t') notes</a></center>\n        </p>\n        <p>\n          <center><a target=\"_blank\" href=\"../../Supplements/Notes.xml\">Note index</a></center>\n        </p>\n      </td>\n    </tr>\n  </table>\n</body></HTML>",
  "Isaiah.14.9.14-t.html": "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01//EN\" \"http://www.w3.org/TR/html4/strict.dtd\"><HTML>\n<!-- \n     Computer generated from NoteMaker[20 Jan 2026]: \n     Changes file: 2023.04.01 - Changes.xml, date: 2022.12.09, number: 3 .\n     Remove this token \"****COMPUTER-GENERATED****\" if you edit this file manually.\n-->\n<head><meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\"/>\n  <title>Isaiah 14:9.14</title>\n</head>\n<body background=\"../../Images/Background\">\n  <h1>Isaiah 14:9.14</h1>\n  <h2>Possible dagesh in samekh. Add note 't'.</h2>\n  <table align=\"center\"  cellpadding=\"5pt\">\n    <tr>\n      <td>\n        <center>\n          <img src=\"../../Changes/2023.04.01 - Changes/images/2022.12.09/3-Detail.jpg\"  border=\"4pt\">\n          </img>\n        </center>\n      </td>\n    </tr>\n    <tr>\n      <td>\n        <center>Credit: Sefaria.org.</center>\n      </td>\n    </tr>\n  </table>\n  <p>\n                    The dageshes in both the kaf and the samekh are of poor quality. \n                    The dagesh in the samekh is reddish and slightly larger.\n                </p>\n  <p>\n                    BHL has no dagesh in the samekh.\n                    BHL Appendix A has no note on this verse.</p>\n  <p>\n    <b>\n      <i>Daniel Holman</i>\n    </b>\n  </p>\n  <p align=\"right\">\n    <b><a target=\"_blank\" href=\"../../Changes/2023.04.01 - Changes/2023.04.01 - Changes.xml?2022.12.09-3\">2023.04.01 - Changes.xml : 2022.12.09-3</a>\n    </b>\n  </p>\n  <table align=\"center\"  cellpadding=\"20pt\"  border=\"1pt\">\n    <tr>\n      <td>\n        <p>\n          <center><a target=\"_blank\" href=\"../../Supplements/Notes.xml?t\">All \"Transcription uncertain\" ('t') notes</a></center>\n        </p>\n        <p>\n          <center><a target=\"_blank\" href=\"../../Supplements/Notes.xml\">Note index</a></center>\n        </p>\n      </td>\n    </tr>\n  </table>\n</body></HTML>",
  "Isaiah.25.10.7-t.html": "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01//EN\" \"http://www.w3.org/TR/html4/strict.dtd\"><HTML>\n<!-- \n     Computer generated from NoteMaker[20 Jan 2026]: \n     Changes file: 2023.04.01 - Changes.xml, date: 2023.01.09, number: 2 .\n     Remove this token \"****COMPUTER-GENERATED****\" if you edit this file manually.\n-->\n<head><meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\"/>\n  <title>Isaiah 25:10.7</title>\n</head>\n<body background=\"../../Images/Background\">\n  <h1>Isaiah 25:10.7</h1>\n  <h2>Move mahapakh from dalet to vav. Add note 't'.</h2>\n  <table align=\"center\"  cellpadding=\"5pt\">\n    <tr>\n      <td>\n        <center>\n          <img src=\"../../Changes/2023.04.01 - Changes/images/2023.01.09/2-Detail.jpg\"  border=\"4pt\">\n          </img>\n        </center>\n      </td>\n    </tr>\n    <tr>\n      <td>\n        <center>Credit: Sefaria.org.</center>\n      </td>\n    </tr>\n  </table>\n  <p>\n                    The mahapakh most likely belongs to the dalet rather than the vav.\n                    The lack of space under the dalet likely caused the shift from the dalet to vav.\n                    The mahapakh will be transcribed under the vav to represent the text image.\n                    Although the changed text places the mahapakh under the vav, \n                        fonts may place the mahapakh slightly to the left of the vav.\n                    This is the case with the Taamey D Web font here.\n                </p>\n  <p>\n                    BHL has the mahapakh on the dalet.\n                    BHL Appendix A makes no comment on this verse.\n                </p>\n  <p>\n    <b>\n      <i>Asael Reiter</i>\n    </b>\n  </p>\n  <p align=\"right\">\n    <b><a target=\"_blank\" href=\"../../Changes/2023.04.01 - Changes/2023.04.01 - Changes.xml?2023.01.09-2\">2023.04.01 - Changes.xml : 2023.01.09-2</a>\n    </b>\n  </p>\n  <table align=\"center\"  cellpadding=\"20pt\"  border=\"1pt\">\n    <tr>\n      <td>\n        <p>\n          <center><a target=\"_blank\" href=\"../../Supplements/Notes.xml?t\">All \"Transcription uncertain\" ('t') notes</a></center>\n        </p>\n        <p>\n          <center><a target=\"_blank\" href=\"../../Supplements/Notes.xml\">Note index</a></center>\n        </p>\n      </td>\n    </tr>\n  </table>\n</body></HTML>",
  "Isaiah.3.15.2-q.html": "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01//EN\" \"http://www.w3.org/TR/html4/strict.dtd\"><HTML>\n<!-- \n     Computer generated from NoteMaker[20 Jan 2026]: \n     Changes file: 2024.10.19 - Changes.xml, date: 2024.04.15, number: 28 .\n     Remove this token \"****COMPUTER-GENERATED****\" if you edit this file manually.\n-->\n<head><meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\"/>\n  <title>Isaiah 3:15.2</title>\n</head>\n<body background=\"../../Images/Background\">\n  <h1>Isaiah 3:15.2</h1>\n  <h2>Remove unsupported maqaf from qere word. Add note 'q'. [מַה־]</h2>\n  <table align=\"center\"  cellpadding=\"5pt\">\n    <tr>\n      <td>\n        <center>\n          <img src=\"../../Changes/2024.10.19 - Changes/images/2024.04.15/28-Detail.jpg\"  border=\"4pt\">\n          </img>\n        </center>\n      </td>\n    </tr>\n    <tr>\n      <td>\n        <center>Credit: Sefaria.org.</center>\n      </td>\n    </tr>\n  </table>\n  <p>The qere word, מה, and its qere successor, לכם, are on separate lines in the left margin. No maqaf is apparent in the ketiv body.</p>\n  <p>BHL has a maqaf at the end of this word, showing the present text, מַה־לָּכֶם֙.  BHLA has no entry for this verse.</p>\n  <p>\n    <b>\n      <i>CVK</i>\n    </b>\n  </p>\n  <p align=\"right\">\n    <b><a target=\"_blank\" href=\"../../Changes/2024.10.19 - Changes/2024.10.19 - Changes.xml?2024.04.15-28\">2024.10.19 - Changes.xml : 2024.04.15-28</a>\n    </b>\n  </p>\n  <table align=\"center\"  cellpadding=\"20pt\"  border=\"1pt\">\n    <tr>\n      <td>\n        <p>\n          <center><a target=\"_blank\" href=\"../../Supplements/Notes.xml?q\">All \"UXLC differs from the conventional word for the qere.\" ('q') notes</a></center>\n        </p>\n        <p>\n          <center><a target=\"_blank\" href=\"../../Supplements/Notes.xml\">Note index</a></center>\n        </p>\n      </td>\n    </tr>\n  </table>\n</body></HTML>",
  "Isaiah.37.4.7-t.html": "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01//EN\" \"http://www.w3.org/TR/html4/strict.dtd\"><HTML>\n<!-- \n     Computer generated from NoteMaker[20 Jan 2026]: \n     Changes file: 2023.04.01 - Changes.xml, date: 2022.12.09, number: 13 .\n     Remove this token \"****COMPUTER-GENERATED****\" if you edit this file manually.\n-->\n<head><meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\"/>\n  <title>Isaiah 37:4.7</title>\n</head>\n<body background=\"../../Images/Background\">\n  <h1>Isaiah 37:4.7</h1>\n  <h2>Examine maqaf at end of word. Add note 't'.</h2>\n  <table align=\"center\"  cellpadding=\"5pt\">\n    <tr>\n      <td>\n        <center>\n          <img src=\"../../Changes/2023.04.01 - Changes/images/2022.12.09/13-Detail.jpg\"  border=\"4pt\">\n          </img>\n        </center>\n      </td>\n    </tr>\n    <tr>\n      <td>\n        <center>Credit: Sefaria.org.</center>\n      </td>\n    </tr>\n  </table>\n  <p>\n                    The image shows a slight horizontal shape on the leading fork of the shin. \n                    Other local shins do not have similar shapes on the leading fork.\n                </p>\n  <p>\n                    BHL has a maqaf at the end of this word. \n                    BHL Appendix A has no comment on this word.\n                </p>\n  <p>\n    <b>\n      <i>Daniel Holman</i>\n    </b>\n  </p>\n  <p align=\"right\">\n    <b><a target=\"_blank\" href=\"../../Changes/2023.04.01 - Changes/2023.04.01 - Changes.xml?2022.12.09-13\">2023.04.01 - Changes.xml : 2022.12.09-13</a>\n    </b>\n  </p>\n  <table align=\"center\"  cellpadding=\"20pt\"  border=\"1pt\">\n    <tr>\n      <td>\n        <p>\n          <center><a target=\"_blank\" href=\"../../Supplements/Notes.xml?t\">All \"Transcription uncertain\" ('t') notes</a></center>\n        </p>\n        <p>\n          <center><a target=\"_blank\" href=\"../../Supplements/Notes.xml\">Note index</a></center>\n        </p>\n      </td>\n    </tr>\n  </table>\n</body></HTML>",
  "Isaiah.46.4.6-c.html": "<html>\n<header profile=\"http://www.w3.org/2005/11/profile\" > \n        <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\"/> \n        <title>Isaiah 46:4.6</title>\n</header>\n    \n<body background=\"../../Images/Background\">\n        <h1>Isaiah 46:4.6</h1>\n        <h4>In the LC the shin has no shin/sin dots.</h4>\n        \n        <table align=\"center\" cellpadding=\"5pt\"><tr><td>\n            <center>\n                <img src=\"../../Changes/2021.10.19 - Changes/images/2021.07.03/2-Detail.jpg\" border=\"4pt\"/>\n            </center>\n        </td></tr>\n        <p/>\n        <tr><td>\n            <center><i>Credit: Sefaria.org.\n            </i></center>\n        </td></tr>\n        </table>\n        <p/>\n          The \"Miqra according to the Masorah\" shows a sin dot on the shin.\n        <p/>\n        The UXLC has 46 shin consonants that lack either shin or sin dots. \n        Forty-three  of these shin consonants are the second shin in the word \"&#x05d9;&#x05e9;&#x05e9;&#x05db;&#x05e8;\",\n        yissakhar (The 5-th son of Leah), which traditionally has no shin/sin dots. \n        The remaining 3 shins without either shin or sin dots are Deut 24:16.1,\n        Isa 46:4.6, and Hag 1:10.5.\n        <p/>\n        This is probably a scribal error. Note that the UXLC has 58,195 shins in its normal and qere tags. \n        Of these shins, 3, representing 0.0052% of the total qere shins, are in error in this way.\n        <p/>\n        \n        <b><i>Ben Denckla</i></b>\n        <p align=\"right\"><b>2021.10.19 - Changes.xml : 2021.07.03-2</b></p>\n        <p/>\n        <table border=\"1pt\" align=\"center\" cellpadding=\"16pt\">\n            <tr><td>\n              <span style=\"color:blue;font-size:14pt\">\n                  <a target=\"_blank\" href=\"../../Supplements/Notes.xml?c\">All \"Text is correct\" ('c') notes</a>\n              </span>\n              <p/>\n              <span style=\"color:blue;font-size:14pt\">\n                  <center><a target=\"_blank\" href=\"../../Supplements/Notes.xml\">Note index</a></center>\n              </span>\n            </td?</tr>\n        </table>\n        <p/>\n        </body>\n</html>\n",
  "Isaiah.8.6.10-t.html": "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01//EN\" \"http://www.w3.org/TR/html4/strict.dtd\"><HTML>\n<!-- \n     Computer generated from NoteMaker[20 Jan 2026]: \n     Changes file: 2023.04.01 - Changes.xml, date: 2022.12.09, number: 1 .\n     Remove this token \"****COMPUTER-GENERATED****\" if you edit this file manually.\n-->\n<head><meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\"/>\n  <title>Isaiah 8:6.10</title>\n</head>\n<body background=\"../../Images/Background\">\n  <h1>Isaiah 8:6.10</h1>\n  <h2>Possible dagesh in alef. Add note 't'.</h2>\n  <table align=\"center\"  cellpadding=\"5pt\">\n    <tr>\n      <td>\n        <center>\n          <img src=\"../../Changes/2023.04.01 - Changes/images/2022.12.09/1-Detail.jpg\"  border=\"4pt\">\n          </img>\n        </center>\n      </td>\n    </tr>\n    <tr>\n      <td>\n        <center>Credit: Sefaria.org.</center>\n      </td>\n    </tr>\n  </table>\n  <p>\n                    The putative dagesh is well-sized and well-positioned, but reddish. \n                    Alefs normally do not have dageshes.\n                </p>\n  <p>\n                    BHL has no dagesh in the alef.\n                    BHL Appendix A has a dagesh in the alef.\n                </p>\n  <p>\n    <b>\n      <i>Daniel Holman</i>\n    </b>\n  </p>\n  <p align=\"right\">\n    <b><a target=\"_blank\" href=\"../../Changes/2023.04.01 - Changes/2023.04.01 - Changes.xml?2022.12.09-1\">2023.04.01 - Changes.xml : 2022.12.09-1</a>\n    </b>\n  </p>\n  <table align=\"center\"  cellpadding=\"20pt\"  border=\"1pt\">\n    <tr>\n      <td>\n        <p>\n          <center><a target=\"_blank\" href=\"../../Supplements/Notes.xml?t\">All \"Transcription uncertain\" ('t') notes</a></center>\n        </p>\n        <p>\n          <center><a target=\"_blank\" href=\"../../Supplements/Notes.xml\">Note index</a></center>\n        </p>\n      </td>\n    </tr>\n  </table>\n</body></HTML>",
  "Isaiah.9.6.1-c.html": "<html>\n<header profile=\"http://www.w3.org/2005/11/profile\" > \n        <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\"/> \n        <title>Isaiah 9:6.1</title>\n</header>\n    \n<body background=\"../../Images/Background\">\n        <h1>Isaiah 9:6.1</h1>\n        <h4>The UXLC follows the LC in making the second consonant a mem-sofit, &#x05dd;.</h4>\n        <table align=\"center\" cellpadding=\"5pt\"><tr><td>\n            <center>\n                <img src=\"Isaiah.9.6.1.jpg\" border=\"4pt\"/>\n            </center>\n        </td></tr>\n        <p/>\n        <tr><td>\n            <center><i>Credit: Sefaria.org.\n            </i></center>\n        </td></tr>\n        </table>\n        <p/>\n        A medial mem, &#x05de;, would be expected.\n        <p/>\n        <table border=\"1pt\" align=\"center\" cellpadding=\"16pt\">\n            <tr><td>\n              <span style=\"color:blue;font-size:14pt\">\n                  <a target=\"_blank\" href=\"../../Supplements/Notes.xml?c\">All \"Text is correct relative to LC\" ('c') notes</a>\n              </span>\n              <p/>\n              <span style=\"color:blue;font-size:14pt\">\n                  <center><a target=\"_blank\" href=\"../../Supplements/Notes.xml\">Note index</a></center>\n              </span>\n            </td?</tr>\n        </table>\n        <p/>\n        </body>\n</html>\n"
}
