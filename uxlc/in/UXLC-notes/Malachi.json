  "Malachi.2.17.4-t.html": "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01//EN\" \"http://www.w3.org/TR/html4/strict.dtd\"><HTML>\n<!-- \n     Computer generated from NoteMaker[20 Jan 2026]: \n     Changes file: 2023.04.01 - Changes.xml, date: 2022.12.12, number: 15 .\n     Remove this token \"****COMPUTER-GENERATED****\" if you edit this file manually.\n-->\n<head><meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\"/>\n  <title>Malachi 2:17.4</title>\n</head>\n<body background=\"../../Images/Background\">\n  <h1>Malachi 2:17.4</h1>\n  <h2>Move tipeha under tav to under resh. Add note 't'.</h2>\n  <table align=\"center\"  cellpadding=\"5pt\">\n    <tr>\n      <td>\n        <center>\n          <img src=\"../../Changes/2023.04.01 - Changes/images/2022.12.12/15-Detail.jpg\"  border=\"4pt\">\n          </img>\n        </center>\n      </td>\n    </tr>\n    <tr>\n      <td>\n        <center>Credit: Sefaria.org.</center>\n      </td>\n    </tr>\n  </table>\n  <p>\n                    Normally, accents are written after a vowel. \n                    The tipeha in the image could be considered under either the resh or the tav.\n                    Space is available after the segol to write the tipeha had the scribe intended to do so.\n                </p>\n  <p>\n                    BHL has the tipeha under the tav positioned after the segol.\n                    BHL Appendix A has the tipeha under the tav but positioned before the segol.\n                </p>\n  <p>\n    <b>\n      <i>Daniel Holman</i>\n    </b>\n  </p>\n  <p align=\"right\">\n    <b><a target=\"_blank\" href=\"../../Changes/2023.04.01 - Changes/2023.04.01 - Changes.xml?2022.12.12-15\">2023.04.01 - Changes.xml : 2022.12.12-15</a>\n    </b>\n  </p>\n  <table align=\"center\"  cellpadding=\"20pt\"  border=\"1pt\">\n    <tr>\n      <td>\n        <p>\n          <center><a target=\"_blank\" href=\"../../Supplements/Notes.xml?t\">All \"Transcription uncertain\" ('t') notes</a></center>\n        </p>\n        <p>\n          <center><a target=\"_blank\" href=\"../../Supplements/Notes.xml\">Note index</a></center>\n        </p>\n      </td>\n    </tr>\n  </table>\n</body></HTML>"
