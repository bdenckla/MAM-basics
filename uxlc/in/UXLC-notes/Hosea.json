  "Hosea.12.10.8-t.html": "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01//EN\" \"http://www.w3.org/TR/html4/strict.dtd\"><HTML>\n<!-- \n     Computer generated from NoteMaker[20 Jan 2026]: \n     Changes file: 2023.04.01 - Changes.xml, date: 2022.12.12, number: 2 .\n     Remove this token \"****COMPUTER-GENERATED****\" if you edit this file manually.\n-->\n<head><meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\"/>\n  <title>Hosea 12:10.8</title>\n</head>\n<body background=\"../../Images/Background\">\n  <h1>Hosea 12:10.8</h1>\n  <h2>Note possible meteg on bet. Add note 't'.</h2>\n  <table align=\"center\"  cellpadding=\"5pt\">\n    <tr>\n      <td>\n        <center>\n          <img src=\"../../Changes/2023.04.01 - Changes/images/2022.12.12/2-Detail.jpg\"  border=\"4pt\">\n          </img>\n        </center>\n      </td>\n    </tr>\n    <tr>\n      <td>\n        <center>Credit: Sefaria.org.</center>\n      </td>\n    </tr>\n  </table>\n  <p>\n                    At question is the dark vertical line on the leading edge of the bet.\n                    It is not expected that a meteg would be written in this position.\n                    It is too low to be a paseq.\n                </p>\n  <p>\n                    BHL agrees with the reference UXLC text.\n                    BHL Appendix A makes no comment on this verse.\n                </p>\n  <p>\n    <b>\n      <i>Daniel Holman</i>\n    </b>\n  </p>\n  <p align=\"right\">\n    <b><a target=\"_blank\" href=\"../../Changes/2023.04.01 - Changes/2023.04.01 - Changes.xml?2022.12.12-2\">2023.04.01 - Changes.xml : 2022.12.12-2</a>\n    </b>\n  </p>\n  <table align=\"center\"  cellpadding=\"20pt\"  border=\"1pt\">\n    <tr>\n      <td>\n        <p>\n          <center><a target=\"_blank\" href=\"../../Supplements/Notes.xml?t\">All \"Transcription uncertain\" ('t') notes</a></center>\n        </p>\n        <p>\n          <center><a target=\"_blank\" href=\"../../Supplements/Notes.xml\">Note index</a></center>\n        </p>\n      </td>\n    </tr>\n  </table>\n</body></HTML>",
  "Hosea.2.16.8-c.html": "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01//EN\" \"http://www.w3.org/TR/html4/strict.dtd\"><HTML>\n<!-- \n     Computer generated from NoteMaker[20 Jan 2026]: \n     Changes file: 2021.10.19 - Changes.xml, date: 2021.08.07, number: 26 .\n     Remove this token \"****COMPUTER-GENERATED****\" if you edit this file manually.\n-->\n<head><meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\"/>\n  <title>Hosea 2:16.8</title>\n</head>\n<body background=\"../../Images/Background\">\n  <h1>Hosea 2:16.8</h1>\n  <h2>Word lacks accent, add note 'c'; MAM ends the word with a Maqaf (  ס־  ).</h2>\n  <table align=\"center\"  cellpadding=\"5pt\">\n    <tr>\n      <td>\n        <center>\n          <img src=\"../../Changes/2021.10.19 - Changes/images/2021.08.07/26-Detail.jpg\"  border=\"4pt\">\n          </img>\n        </center>\n      </td>\n    </tr>\n    <tr>\n      <td>\n        <center>Credit: Sefaria.org.</center>\n      </td>\n    </tr>\n  </table>\n  <p>\n    <b>\n      <i>Ben Denckla</i>\n    </b>\n  </p>\n  <p align=\"right\">\n    <b><a target=\"_blank\" href=\"../../Changes/2021.10.19 - Changes/2021.10.19 - Changes.xml?2021.08.07-26\">2021.10.19 - Changes.xml : 2021.08.07-26</a>\n    </b>\n  </p>\n  <table align=\"center\"  cellpadding=\"20pt\"  border=\"1pt\">\n    <tr>\n      <td>\n        <p>\n          <center><a target=\"_blank\" href=\"../../Supplements/Notes.xml?c\">All \"Text is correct relative to LC. Usually this marks a peculiarity of the LC relative to the other Masoretic texts.\" ('c') notes</a></center>\n        </p>\n        <p>\n          <center><a target=\"_blank\" href=\"../../Supplements/Notes.xml\">Note index</a></center>\n        </p>\n      </td>\n    </tr>\n  </table>\n</body></HTML>"
