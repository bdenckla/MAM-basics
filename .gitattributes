# Auto detect text files and perform LF normalization
* text=auto eol=lf

# For any CSV file, force Git to:
#
#    1. normalize line endings for this file on checkin
#    2. convert line endings to CRLF when the file is checked out
#
# The main reason we do this is because of the following two facts:
#
#    1. We write CSV files using the Python
#       csv module, which, by default, uses \r\n (CRLF) line terminator
#       unconditionally, i.e. on all platforms.
#    2. We want these CSV files we write to match what git checks out
#       for them in the working dir.
#
*.csv text eol=crlf

# The HBCE Psalms comparison's tab-separated outputs end a row with a tab when its last
# field is empty. That tab is data, not trailing whitespace, so `git diff --check` must
# not report it.
hbce-psalms/out/*.tsv whitespace=-trailing-space

# Binary assets: never convert. Copied verbatim from wlc-utils' .gitattributes
# (wlc-utils#50) ahead of that repo's corpus arriving, because git applies
# .gitattributes at `git add` time: were these rules to differ between the two
# repos, the incoming blob would differ too, and byte-identity with the original
# is the evidence that the copy is exact.
*.png  binary
*.jpg  binary
*.pdf  binary
*.woff2 binary
MAM-parsed/historical/*.zip binary

# Faithful Wikisource captures retain source-significant trailing spaces.
in/mam-ws-special/*.mediawiki whitespace=-blank-at-eol

# This migrated page preserves the sanctioned legacy HTML byte-for-byte,
# including its existing line-final space before the following wrapped prose.
gh-pages/yeivin-itm/yeivin_itm-311_317.html whitespace=-blank-at-eol
